<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_res_mcp_form" model="ir.ui.view">
    <field name="name">res.mcp.form</field>
    <field name="model">res.mcp</field>
    <field name="arch" type="xml">
      <form string="MCP Resource">
        <header>
          <button name="run" type="object" string="Run" class="btn-primary" />
          <field name="status" widget="statusbar" statusbar_visible="active,done" options="{'clickable': '1', 'fold_field': 'fold'}" />
        </header>
        <sheet>
          <div name="button_box" id="button_box" class="oe_button_box" />
          <field name="image_128" widget="image" class="oe_avatar" />
          <div class="oe_title">
            <h1 class="d-flex flex-row">
              <field name="is_favorite" nolabel="1" widget="boolean_favorite" class="me-2" />
              <field name="name" class="o_text_overflow" placeholder="t.ex. Handboken" modifiers="{&quot;required&quot;: true}" />
            </h1>
          </div>
          <group>
            <field name="url" />
            <field name="mcp_api_key" />
          </group>
          <group>
            <field name="company_id" groups="base.group_multi_company" />
<!--
            <field name="color" />
-->
            <field name="debug" widget="boolean_toggle" />
          </group>
          <notebook>
            <page name="Schedual">
              <group>
                <group>
                  <field name="cron_interval_type" />
                  <field name="cron_interval_number" />
                  <field name="cron_record_limit" />
                  <field name="last_run" readonly="1" />
                </group>
              </group>
            </page>
            <page name="desc" string="Description">
              <field name="description" nolabel="1" />
            </page>
          </notebook>
        </sheet>
         <chatter/>
      </form>
    </field>
  </record>


  
  <record id="view_res_mcp_list" model="ir.ui.view">
    <field name="name">res.mcp.list</field>
    <field name="model">res.mcp</field>
    <field name="arch" type="xml">
      <list string="MCP Resources">
        <field name="sequence" widget="handle" />
        <field name="name" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="status" />
        <field name="last_run" />
      </list>
    </field>
  </record>
