  <record id="view_res_mcp_kanban" model="ir.ui.view">
    <field name="name">res.mcp.kanban</field>
    <field name="model">res.mcp</field>
    <field name="arch" type="xml">
      <kanban>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_global_click o_kanban_record #{record.status.raw_value}">
              <field name="image_128" widget="image" class="oe_kanban_avatar" />
              <div>
                <strong>
                  <field name="name" />
                </strong>
              </div>
              <div>
                <field name="status" />
              </div>
              <div>
                <field name="last_run" />
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="view_res_mcp_calendar" model="ir.ui.view">
    <field name="name">res.mcp.calendar</field>
    <field name="model">res.mcp</field>
    <field name="arch" type="xml">
      <calendar string="MCP Resources Calendar" date_start="last_run">
        <field name="name" />
      </calendar>
    </field>
  </record>
  <record id="action_res_mcp" model="ir.actions.act_window">
    <field name="name">MCP Resources</field>
    <field name="res_model">res.mcp</field>
    <field name="view_mode">kanban,list,form,calendar</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create or upload MCP-resources.</p>
    </field>
  </record>
  <menuitem id="menu_res_mcp_root" name="MCP Resources" parent="ai_agent.menu_ai_agent_configuration" sequence="10" />
  <menuitem id="menu_res_mcp_resources" name="Remote Resources" parent="menu_res_mcp_root" action="action_res_mcp" sequence="10" />
</odoo>
