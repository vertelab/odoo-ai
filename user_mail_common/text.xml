<odoo>
    <data>
        <record id="view_users_form_conf_mail" model="ir.ui.view">
            <field name="name">res.users.form.mail</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <field name="email" position="replace"/>
                <label for="login" position="replace">
                    <label class="oe_edit_only" for="login" string="Login Name / Email Address"/>
                </label>
                <field name="login" position="replace">
                    <div>
                        <h2 class="oe_inline">
                            <field class="oe_inline" name="login"/>
                        </h2>
                        <field class="oe_read_only" name="email" readonly="1"/>
                    </div></field>
                <notebook position="inside">
                    <page string="E-mail settings">
                        <group>
                            <field name="postfix_active" string="Postfix Active"/>
                        </group>
                        <group invisible="postfix_active == False">
                            <field groups="base.group_erp_manager" name="postfix_mail"/>
                            <group string="Vacation">
                                <field name="vacation_active"/>
                            </group>
                            <group>
                            </group>
                        </group>
                        <group>
                            <field name="postfix_active" string="Postfix Active"/>
                        </group>
                        <group invisible="postfix_active == False">
                            <field groups="base.group_erp_manager" name="postfix_mail"/>
                            <separator string="Vacation"/>
                            <field name="vacation_active"/>
                            <newline/>
                            <field invisible="vacation_active == False" name="vacation_from" required="vacation_active == True"/>
                            <field invisible="vacation_active == False" name="vacation_to" required="vacation_active == True"/>
                            <field invisible="vacation_active == False" name="vacation_subject" placeholder="I am at vacation" required="vacation_active == True"/>
                            <field invisible="vacation_active == False" name="vacation_text" nolabel="1" required="vacation_active == True"/>
                            <field invisible="vacation_active == False" name="vacation_forward" placeholder="my@vacationmail.com" required="vacation_active == True"/>
                            <separator string="Forward"/>
                            <field name="forward_active"/>
                            <newline/>
                            <field invisible="forward_active == False" name="forward_address" nolabel="1" placeholder="my@temporarymail.com" required="forward_active == True"/>
                            <field invisible="forward_active == False" name="forward_cp"/>
                            <separator string="Virus check"/>
                            <field name="virus_active"/>
                            <separator string="Spam check"/>
                            <field name="spam_active"/>
                            <newline/>
                            <field invisible="spam_active == False" name="spam_tag" required="spam_active == True"/>
                            <field invisible="spam_active == False" name="spam_tag2" required="spam_active == True"/>
                            <field invisible="spam_active == False" name="spam_killevel" required="spam_active == True"/>
                            <separator string="Alias"/>
                            <newline/>
                            <field name="postfix_alias_ids" nolabel="1" widget="one2many_list">
                                <list editable="bottom" string="Mail alias">
                                    <field name="name"/>
                                    <field class="oe_read_only" invisible="name == ''" name="mail"/>
                                    <field name="active"/>
                                </list></field>
                            <separator string="Misc"/>
                            <field name="maildir"/>
                            <newline/>
                            <field name="quota"/>
                            <newline/>
                        </group>
