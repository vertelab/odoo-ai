<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Mail som graf-nod: user_mail_ai.mail → :MailMessage
             + SENT_BY-kant till :OdooPartner (res.partner).
             Synkas av befintlig cron_sync_graph (5 min) — ingen ny graf-kod. -->
        <record id="graph_node_mail_message" model="graph.node.definition">
            <field name="model_id" ref="model_user_mail_ai_mail"/>
            <field name="graph_label">MailMessage</field>
            <field name="name_field">subject</field>
            <field name="node_properties">{"received_at": "received_at", "folder": "folder"}</field>
            <field name="edge_definitions">[{"type": "SENT_BY", "target_label": "OdooPartner", "target_id_field": "partner_id"}]</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
