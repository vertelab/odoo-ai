<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- DEMO: Kundsupport-Maja (mail + webhook + web_ui) -->

    <record id="demo_coworker_support" model="ai.coworker">
        <field name="name">Kundsupport-Maja</field>
        <field name="description">Du ar Maja, en vänlig kundsupportagent.
Svarar alltid pa svenska. Hjalpsam och loser kundens problem.</field>
        <field name="status">active</field>
        <field name="sequence">10</field>
        <field name="channel_alias">maja</field>
        <field name="response_mode">mention</field>
        <field name="orchestration_mode">single</field>
    </record>

    <record id="demo_support_init_mail" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_support"/>
        <field name="init_type">mail</field>
        <field name="active">True</field>
        <field name="sequence">10</field>
        <field name="alias_name">support</field>
    </record>

    <record id="demo_support_init_webhook" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_support"/>
        <field name="init_type">webhook</field>
        <field name="active">True</field>
        <field name="sequence">20</field>
    </record>

    <record id="demo_support_init_web_ui" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_support"/>
        <field name="init_type">web_ui</field>
        <field name="active">True</field>
        <field name="sequence">30</field>
        <field name="show_in_chat">True</field>
    </record>

    <!-- DEMO: Orderanalys-Adam (server_action + cron) -->

    <record id="demo_coworker_orders" model="ai.coworker">
        <field name="name">Orderanalys-Adam</field>
        <field name="description">Du ar Adam, en analytiker som granskar forsaljningsordrar.
Analysera ordrar och identifiera problem som forseningar, stora rabatter,
saknade dokument eller betalningsproblem.</field>
        <field name="status">active</field>
        <field name="sequence">20</field>
        <field name="channel_alias">adam</field>
        <field name="orchestration_mode">single</field>
    </record>

    <record id="demo_orders_init_server" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_orders"/>
        <field name="init_type">server_action</field>
        <field name="active">True</field>
        <field name="sequence">10</field>
        <field name="server_action_use_wizard">True</field>
    </record>

    <record id="demo_orders_init_cron" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_orders"/>
        <field name="init_type">cron</field>
        <field name="active">True</field>
        <field name="sequence">20</field>
        <field name="cron_interval_number">6</field>
        <field name="cron_interval_type">hours</field>
        <field name="filter_domain">[('state', '=', 'sale')]</field>
    </record>

    <!-- DEMO: Webb-Gustav (web_ui + openai_api) -->

    <record id="demo_coworker_web" model="ai.coworker">
        <field name="name">Webb-Gustav</field>
        <field name="description">Du ar Gustav, en allman assistent som kan hjalpa till med
Odoo-relaterade fragor. Du har tillgang till dokumentation.</field>
        <field name="status">active</field>
        <field name="sequence">30</field>
        <field name="channel_alias">gustav</field>
        <field name="orchestration_mode">single</field>
    </record>

    <record id="demo_web_init_ui" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_web"/>
        <field name="init_type">web_ui</field>
        <field name="active">True</field>
        <field name="sequence">10</field>
        <field name="show_in_chat">True</field>
    </record>

    <record id="demo_web_init_openai" model="ai.coworker.init_type">
        <field name="coworker_id" ref="demo_coworker_web"/>
        <field name="init_type">openai_api</field>
        <field name="active">True</field>
        <field name="sequence">20</field>
        <field name="rate_limit_rpm">60</field>
        <field name="rate_limit_tpm">200000</field>
    </record>

</odoo>
