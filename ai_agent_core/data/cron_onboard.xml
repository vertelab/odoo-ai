<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron: ONBOARD scan (runs every 4 hours) -->
    <record id="cron_onboard_scan" model="ir.cron">
        <field name="name">AI: ONBOARD — scanna efter quest-kandidater</field>
        <field name="model_id" ref="model_ai_onboard_candidate"/>
        <field name="state">code</field>
        <field name="code">model.scan_instance()</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
