<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI-kostnadsaggregat (ai-kostnad-till-likviditet 2.x): bygger om
         ai.cost.period.line för innevarande och förra perioden. Idempotent. -->
    <record id="cron_cost_aggregate" model="ir.cron">
        <field name="name">AI: Aggregera kostnad per period</field>
        <field name="model_id" ref="model_ai_cost_period_line"/>
        <field name="state">code</field>
        <field name="code">model.cron_aggregate(granularity='month')</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
