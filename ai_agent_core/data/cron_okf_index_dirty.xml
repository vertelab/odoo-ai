<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: OKF lätt indexerare (var 5:e minut) — plockar upp dirty-poster
         från alla modeller som bär ai.okf.mixin (_okf_indexable_models(),
         utökningsbar av bryggor) och gör det tunga arbetet: sammanfattning
         (modellens egen → Allmän assistent → trunkering), upsert via
         _okf_upsert, rensning av flaggan. Tungt arbete sker här, aldrig i
         write().

         Modellen är ai.okf.concept: cronen anropar en @api.model-metod, så
         vilken konkret modell som helst duger — men ai.okf.mixin är ABSTRAKT
         och får ingen ir.model-post, så ref="model_ai_okf_mixin" kan aldrig
         lösas upp (uppgraderingen kraschade på ParseError). ai.okf.concept är
         den konkreta modell som bär mixinen sedan ai.memory pensionerades
         (okf-mixin F2). -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_okf_index_dirty" model="cron.task">
            <field name="name">OKF: Indexera dirty-artefakter</field>
            <field name="technical_name">ai_okf_index_dirty</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.mixin</field>
            <field name="method_name">_okf_cron_index_dirty</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="sequence">5</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_task_cron_okf_backfill_embeddings" model="cron.task">
            <field name="name">OKF: Efterfyll saknade vektorer</field>
            <field name="technical_name">ai_okf_backfill_embeddings</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.concept</field>
            <field name="method_name">_okf_cron_backfill_embeddings</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="sequence">6</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
