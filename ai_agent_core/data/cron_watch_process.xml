<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Asynkron watch-kö (fix-watch-async): cron som processar
         watch-sessioner i egna transaktioner per session.
         AI-körningen sker ALDRIG i base_automation-transaktionen —
         _trigger_watch skapar bara sessionen (watch_pending=True),
         den här cron:en kör coworkern asynkront. -->
    <record id="ir_actions_server_watch_process" model="ir.actions.server">
        <field name="name">AI: Processera watch-kön</field>
        <field name="model_id" ref="model_ai_coworker_session"/>
        <field name="state">code</field>
        <field name="code">
model._process_watch_sessions()
        </field>
    </record>

    <record id="cron_watch_process" model="ir.cron">
        <field name="name">AI: Processera watch-kön</field>
        <field name="cron_name">AI: Processera watch-kön</field>
        <field name="ir_actions_server_id" ref="ir_actions_server_watch_process"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
