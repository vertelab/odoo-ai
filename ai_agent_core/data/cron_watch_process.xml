<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Asynkron watch-kö (fix-watch-async): cron som processar
         watch-sessioner i egna transaktioner per session.
         AI-körningen sker ALDRIG i base_automation-transaktionen —
         _trigger_watch skapar bara sessionen (watch_pending=True),
         den här cron:en kör coworkern asynkront. -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_watch_process" model="cron.task">
            <field name="name">AI: Processera watch-kön</field>
            <field name="technical_name">ai_watch_process</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.coworker.session</field>
            <field name="method_name">_process_watch_sessions</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
