<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Löpande destillering (task 4.3): distillerar nya koncept nattetid -->
    <record id="cron_workspace_distill" model="ir.cron">
        <field name="name">Workspace: Distill new concepts (L2/L3)</field>
        <field name="model_id" ref="model_ai_okf_concept"/>
        <field name="state">code</field>
        <field name="code">model._distill_inbox_batch(limit=50, generated_by='nightly')</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
