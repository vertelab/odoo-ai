<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron: OKF uppladdningskö (var 2:a minut) — processar köade
         uppladdningar i bakgrunden (Web UI async). -->
    <record id="cron_okf_process_uploads" model="ir.cron">
        <field name="name">OKF: Processa uppladdningskö</field>
        <field name="model_id" ref="model_ai_okf_upload"/>
        <field name="state">code</field>
        <field name="code">env['ai.okf.upload']._cron_process_uploads()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>
</odoo>
