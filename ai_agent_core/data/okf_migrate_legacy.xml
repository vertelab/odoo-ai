<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Server action: migrera legacy-data → OKF (tasks 6.1–6.5) -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_okf_migrate_legacy_once" model="cron.task">
            <field name="name">OKF: Migrera legacy-data (engång)</field>
            <field name="technical_name">ai_okf_migrate_legacy_once</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.concept</field>
            <field name="method_name">action_migrate_legacy</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
