<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Heartbeat-processorn (bevakning-over-tid D1): väckaren
         (_heartbeat_all → _heartbeat) skapar bara sessionen med
         heartbeat_pending=True; den här cron:en kör coworkern asynkront i
         en egen transaktion per session. Samma mönster som watch-kön. -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_heartbeat_process" model="cron.task">
            <field name="name">AI: Processera heartbeat-kön</field>
            <field name="technical_name">ai_heartbeat_process</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.coworker</field>
            <field name="method_name">_process_heartbeat_sessions</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_task_cron_run_metrics" model="cron.task">
            <field name="name">AI: Mät körningar per init-typ</field>
            <field name="technical_name">ai_run_metrics</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.coworker</field>
            <field name="method_name">_cron_measure_runs</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
