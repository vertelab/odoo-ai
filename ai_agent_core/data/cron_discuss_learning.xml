<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Discuss-lärande (discuss-learning-cron).
         Extraherar lärdomar ur gårdagens publika kanalmeddelanden till
         avsändarens personliga minne (ai.personal.memory). Bara egna
         meddelanden (author_id), bara channel_type='channel'.

         SKAPAS INAKTIV: vägen har aldrig körts och läser riktiga kanaler.
         En människa aktiverar den efter att ha verifierat ett manuellt
         anrop. Idempotent per meddelande (source_ref='discuss,<id>'). -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_discuss_learning" model="cron.task">
            <field name="name">AI: Extrahera lärdomar från Discuss</field>
            <field name="technical_name">ai_discuss_learning</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.personal.memory</field>
            <field name="method_name">cron_extract_from_discuss</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
