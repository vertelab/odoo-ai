<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- Cron: Weekly Kaizen (runs every Sunday at 03:00) -->
    <record id="cron_kaizen_weekly" model="ir.cron">
        <field name="name">AI: Veckovis Kaizen-rapport</field>
        <field name="model_id" ref="model_ai_kaizen_report"/>
        <field name="state">code</field>
        <field name="code">model.generate_weekly_report()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    </data>
</odoo>
