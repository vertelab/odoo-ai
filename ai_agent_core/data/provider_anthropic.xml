<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Anthropic AI Provider — api_key TOM, nyckel via env (pillar) -->
        <record id="provider_anthropic" model="ai.provider">
            <field name="name">Anthropic</field>
            <field name="provider_type">anthropic</field>
            <field name="base_url">https://api.anthropic.com/v1</field>
            <field name="api_style">anthropic</field>
            <field name="is_key_required" eval="True"/>
            <field name="timeout">120</field>
            <field name="retry_count">3</field>
            <field name="active" eval="True"/>
            <field name="status">confirmed</field>
        </record>

    </data>
</odoo>
