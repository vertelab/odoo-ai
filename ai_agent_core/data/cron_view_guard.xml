<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- sv_SE view-translation guard:
         Vertel i18n_extra/sv.po (crm) translated FIELD NAMES inside
         invisible expressions (duplicate_lead_count -> duplicate_kundamne_count,
         use_leads -> use_kundamnen) which breaks Odoo 18 expression parser.
         This cron corrects idempotently - protects even when someone runs
         checkmodule (load-language=sv applies the po file) without
         updating ai_agent_core.

         The po file was fixed 2026-10 (0 broken field names in
         crm/i18n_extra/sv.po, 0 hits in arch_db). The cron is kept as a
         safety net, not as a fix: the module-update path
         (_ensure_init_resources) already covers the checkmodule scenario,
         so the cron only catches a regression introduced between two
         updates. A broken view translation is cosmetic, not urgent -
         weekly is enough. Was every 30 minutes (48 runs/day). -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_view_translation_guard" model="cron.task">
            <field name="name">AI: Korrigera sv_SE-vyoversattningar</field>
            <field name="technical_name">ai_view_translation_guard</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ir.ui.view</field>
            <field name="method_name">_fix_swedish_view_arch</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
