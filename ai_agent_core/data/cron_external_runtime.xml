<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron: livs-heartbeat + städning av externa agent-processer
         (external-agent-runtime D6/D10).

         Bakgrund: Odoo äger livscykeln för processer den startat, och
         POLLAR därför i stället för att kräva att agenten pingar. Två fall
         hanteras:

         1. Sessionen är stängd men processen lever → föräldralös (Odoo
            tappade den, t.ex. vid omstart). Dödas.
         2. Processen är död men sessionen är aktiv → haveriet registreras
            som `error`, så det syns i data i stället för att se ut som en
            tom, "färdigpratad" session.

         3. Processen lever men har överskridit körningens tidsgräns →
            avbryts (timeout, D6). Gränsen är `pi_agent_run_timeout`
            (default 300 s) med en respit så att agentens egen timeout
            hinner verka först.

         Idempotent: en session vars process redan är borta och som redan
         markerats error plockas inte upp igen (status är då inte längre
         active/draft, och ingen PID-gren matchar). -->
    <record id="cron_reap_external_agents" model="ir.cron">
        <field name="name">Extern agent: livs-heartbeat och städning</field>
        <field name="model_id" ref="model_ai_coworker_session"/>
        <field name="state">code</field>
        <field name="code">env['ai.coworker.session']._cron_reap_external(batch_size=200)</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
        <field name="priority">6</field>
    </record>
</odoo>
