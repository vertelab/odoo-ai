<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Base node: res.partner → :OdooPartner -->
        <record id="graph_node_odoo_partner" model="graph.node.definition">
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="graph_label">OdooPartner</field>
            <field name="name_field">name</field>
            <field name="node_properties">{"email": "email", "phone": "phone", "website": "website", "company_id": "company_id"}</field>
            <field name="edge_definitions">[{"type": "BELONGS_TO", "target_label": "Company", "target_id_field": "company_id"}]</field>
            <field name="active">True</field>
        </record>

        <!-- Base node: res.company → :Company -->
        <record id="graph_node_company" model="graph.node.definition">
            <field name="model_id" ref="base.model_res_company"/>
            <field name="graph_label">Company</field>
            <field name="name_field">name</field>
            <field name="node_properties">{"email": "email", "phone": "phone", "website": "website", "vat": "vat"}</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
