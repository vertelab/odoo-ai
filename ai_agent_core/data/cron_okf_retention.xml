<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Retention (memory-retention-enforcement 5.4): fristen deklareras
             i artefakttypens okf_contract och verkställs här. Utan dessa
             poster är retention_days bara en uppgift i ett register som
             ingen läser — värre än ingen retention alls.

             Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_backfill_retention" model="cron.task">
            <field name="name">OKF: Efterfyll retention_end (engångs)</field>
            <field name="technical_name">ai_retention_backfill</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.concept</field>
            <field name="method_name">_cron_backfill_retention</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">20</field>
            <!-- Engångsuppgift: idempotent och billig (bara koncept utan
                 frist), så den får ligga kvar men avstängd efter första
                 körningen. Att lämna den aktiv vore att köra en migration
                 varje natt. -->
            <field name="active" eval="False"/>
        </record>
        <record id="cron_task_cron_warn_retention" model="cron.task">
            <field name="name">OKF: Varna före retention-utgång</field>
            <field name="technical_name">ai_retention_warn</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.concept</field>
            <field name="method_name">_cron_warn_retention</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">21</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_task_cron_enforce_retention" model="cron.task">
            <field name="name">OKF: Verkställ retention (arkivera utgångna)</field>
            <field name="technical_name">ai_retention_enforce</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.okf.concept</field>
            <field name="method_name">_cron_enforce_retention</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">22</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
