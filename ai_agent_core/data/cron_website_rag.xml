<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- F7.1 (okf-mixin): INAKTIVERAD. Mixinen (ai.okf.mixin) täcker samma
             yta — F6 bevisade att publicering → cron → koncept fungerar för
             alla indexerbara modeller, inklusive webbplatsens. Den gamla
             webscraping-RAG:en är därför pensionerad; ingen sida förloras
             (F7.2: antal indexerade koncept oförändrat). -->
        <record id="cron_website_rag_refresh" model="ir.cron">
            <field name="name">Website RAG Refresh</field>
            <field name="model_id" ref="ai_agent_core.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._index_website()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
            <field name="priority">5</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
