<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Faktura-flödet: 2 specialiserade agenter ── -->

        <!-- Agent 1: analyserar mailet → hittar/skapar res.partner -->
        <record id="agent_invoice_partner" model="ai.agent">
            <field name="name">Mail → Partner</field>
            <field name="ai_role">Mail Sender Analyst</field>
            <field name="description">Analyserar avsändaren av ett inkommande mail och hittar rätt res.partner i Odoo — skapar en ny om den saknas (is_company för företag).</field>
            <field name="ai_goal">Hitta eller skapa rätt res.partner från mail-avsändaren via odoo_search/odoo_create.</field>
            <field name="status">active</field>
        </record>

        <!-- Agent 2: analyserar fakturan → skapar korrekt account.move -->
        <record id="agent_invoice_analyser" model="ai.agent">
            <field name="name">Fakturaanalys</field>
            <field name="ai_role">Invoice Analyst</field>
            <field name="description">Analyserar leverantörsfakturor (OCR-text/bilaga) och skapar korrekta account.move (leverantörsfakturor) med rätt partner, journal, ref, datum, skatter och rader.</field>
            <field name="ai_goal">Skapa en korrekt account.move (move_type=in_invoice) från fakturatexten med odoo_search/odoo_create/odoo_call_method.</field>
            <field name="status">active</field>
        </record>

        <!-- ── AI Medarbetare: Faktura-Assistenten ── -->
        <record id="coworker_invoice_assistant" model="ai.coworker">
            <field name="name">Faktura-Assistenten</field>
            <field name="description">Du är Faktura-Assistenten på ekonomiavdelningen. Du tar emot leverantörsfakturor via mail, identifierar avsändaren (res.partner), läser fakturan (OCR) och skapar korrekta leverantörsfakturor (account.move) i Odoo. Du är noggrann med belopp, datum, moms och referensnummer.</field>
            <field name="status">active</field>
            <field name="orchestration_mode">single</field>
            <field name="heartbeat_enabled" eval="True"/>
            <field name="auto_allowed_tools">["odoo_search", "odoo_create", "odoo_write", "describe_model", "odoo_call_method"]</field>
        </record>

        <record id="coworker_agent_invoice_partner" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_invoice_assistant"/>
            <field name="agent_id" ref="agent_invoice_partner"/>
            <field name="role">member</field>
            <field name="sequence" eval="10"/>
        </record>
        <record id="coworker_agent_invoice_analyser" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_invoice_assistant"/>
            <field name="agent_id" ref="agent_invoice_analyser"/>
            <field name="role">member</field>
            <field name="sequence" eval="20"/>
        </record>

        <!-- Mail-initiering: leverantörsfaktura-flöde -->
        <record id="coworker_invoice_init_mail" model="ai.coworker.init_type">
            <field name="coworker_id" ref="coworker_invoice_assistant"/>
            <field name="init_type">mail</field>
            <field name="enabled" eval="True"/>
            <field name="sequence" eval="10"/>
            <field name="alias_name">faktura</field>
            <field name="alias_contact">everyone</field>
            <field name="mail_action">invoice_ai</field>
            <field name="mail_find_partner" eval="True"/>
            <field name="mail_invoice_agent_ids" eval="[(6, 0, [
                ref('agent_invoice_partner'),
                ref('agent_invoice_analyser'),
            ])]"/>
        </record>

        <!-- web_ui (visas i chat) -->
        <record id="coworker_invoice_init_webui" model="ai.coworker.init_type">
            <field name="coworker_id" ref="coworker_invoice_assistant"/>
            <field name="init_type">web_ui</field>
            <field name="enabled" eval="True"/>
            <field name="sequence" eval="20"/>
        </record>

    </data>
</odoo>
