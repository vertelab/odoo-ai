<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Indexer-crons (tasks 7.3) — skriver ai.okf.concept.
         Dagliga jobb; de ersätter de saknade metoderna i hooks.py
         och skapas som datafiler istället (post_init körs ej vid
         checkmodule-init på redan installerade moduler). -->

    <record id="cron_company_memory_nightly" model="ir.cron">
        <field name="name">Company Memory Nightly Consolidation</field>
        <field name="model_id" ref="model_ai_company_memory"/>
        <field name="state">code</field>
        <field name="code">model.cron_nightly_consolidation()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>

