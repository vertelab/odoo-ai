<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Indexer-crons (tasks 7.3) — skriver ai.okf.concept.
         Dagliga jobb; de ersätter de saknade metoderna i hooks.py
         och skapas som datafiler istället (post_init körs ej vid
         checkmodule-init på redan installerade moduler).

         cron_company_memory.xml togs bort 2026-10-25: den definierade
         SAMMA xmlid (cron_company_memory_nightly) som filen nedan, vilket
         gav två cron.task-poster med samma technical_name. En post räcker. -->
        <!-- Konverterade från ir.cron till cron.task (schemalagt-arbete).
             Se data/cron_mail_reply.xml för varför: ett ir.cron som
             skrivs vid modulladdning kan inte uppdateras medan jobbet
             kör, och uppgraderingen faller på
             "Record cannot be modified right now". cron.task har ingen
             sådan spärr, och motorn äger kadens, lås och körhistorik. -->
        <record id="cron_task_cron_company_memory_nightly" model="cron.task">
            <field name="name">Company Memory Nightly Consolidation</field>
            <field name="technical_name">ai_company_memory_nightly</field>
            <field name="module">ai_agent_core</field>
            <field name="model_name">ai.company.memory</field>
            <field name="method_name">cron_nightly_consolidation</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="sequence">5</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_task_cron_company_memory_partners" model="cron.task">
            <field name="name">Company Memory Partner Customers</field>
