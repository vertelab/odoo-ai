<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Burn rate local warning + conflict + budget change detection (hourly) -->
    <record id="cron_burn_rate_check" model="ir.cron">
        <field name="name">Bifrost: burn rate check</field>
        <field name="model_id" ref="model_ai_coworker"/>
        <field name="state">code</field>
        <field name="code">model.cron_burn_rate_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>

    <!-- Periodisk budget-sammanställning till bifrost (biweekly default) -->
    <record id="cron_budget_summary" model="ir.cron">
        <field name="name">Bifrost: budget summary</field>
        <field name="model_id" ref="model_ai_coworker"/>
        <field name="state">code</field>
        <field name="code">model.cron_budget_summary()</field>
        <field name="interval_number">14</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
