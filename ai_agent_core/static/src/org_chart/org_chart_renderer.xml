<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ai_agent_core.OrgChartRenderer">
        <div class="o_org_chart">
            <div t-if="state.loading" class="p-4 text-muted">Laddar organisationen…</div>
            <div t-elif="state.error" class="alert alert-danger m-3" t-esc="state.error"/>
            <div t-elif="!state.flat.length" class="p-4 text-muted">
                Ingen organisation än — starta AI-onboarding för att bygga den.
            </div>
            <div t-else="" class="o_org_chart_list">
                <t t-foreach="state.flat" t-as="node" t-key="node.id">
                    <div class="o_org_node_row"
                         t-att-style="'padding-left: ' + (node.depth * 28) + 'px'">
                        <button type="button" class="btn o_org_node_card"
                                t-on-click="() => this.openDepartment(node)">
                            <span class="o_org_node_depth"
                                  t-if="node.depth" t-esc="'└─ '"/>
                            <span class="o_org_node_name" t-esc="node.name"/>
                            <span class="o_org_node_badges">
                                <span t-if="node.ai_staff" class="badge text-bg-info">🤖 <t t-esc="node.ai_staff"/></span>
                                <span t-if="node.goal_count" class="badge text-bg-warning">🎯 <t t-esc="node.goal_count"/></span>
                            </span>
                        </button>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
