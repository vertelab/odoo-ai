<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban with employee-style card -->
    <record id="ai_coworker_kanban" model="ir.ui.view">
        <field name="name">ai.coworker.kanban</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status" quick_create="false">
                <field name="name"/>
                <field name="sub_description"/>
                <field name="status"/>
                <field name="orchestration_mode"/>
                <field name="init_type"/>
                <field name="last_status"/>
                <field name="last_run"/>
                <field name="run_count"/>
                <field name="active"/>
                <field name="partner_image_128"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click d-flex flex-row"
                             t-att-class="{'border-danger border-2': !record.active.raw_value}">
                            <!-- Inactive ribbon -->
                            <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>

                            <!-- Image aside (partner → fallback) -->
                            <aside class="o_kanban_aside_full">
                                <t t-if="record.partner_image_128.raw_value">
                                    <field name="partner_image_128" widget="background_image"
                                           options="{'preview_image': 'partner_image_128'}" class="d-block position-relative"/>
                                </t>
                                <t t-else="">
                                    <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                         style="min-height: 100px;">
                                        <i class="fa fa-cubes fa-3x text-secondary opacity-50"/>
                                    </div>
                                </t>
                            </aside>

                            <!-- Main content -->
                            <main class="ms-2 d-flex flex-column" style="min-width: 0;">
                                <!-- Name -->
                                <div class="d-flex align-items-start">
                                    <strong class="fs-5 o_text_overflow">
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <!-- Sub description (truncated) -->
                                <div class="text-muted small mt-0"
                                     style="max-height: 2.8em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                                     t-if="record.sub_description.raw_value">
                                    <field name="sub_description"/>
                                </div>

                                <!-- Footer -->
                                <footer class="mt-auto pt-2">
                                    <div class="d-flex justify-content-between align-items-end w-100">
                                        <!-- Left: badges -->
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span t-if="record.orchestration_mode.raw_value" class="badge"
                                                  t-att-class="{
                                                      'bg-primary': record.orchestration_mode.raw_value == 'single',
                                                      'bg-purple': record.orchestration_mode.raw_value == 'supervisor',
                                                      'bg-success': record.orchestration_mode.raw_value == 'buzz',
                                                      'bg-info': record.orchestration_mode.raw_value == 'linear',
                                                      'bg-warning': record.orchestration_mode.raw_value == 'conference',
                                                      'bg-secondary': record.orchestration_mode.raw_value == 'automation'
                                                  }">
                                                <field name="orchestration_mode"/>
                                            </span>
                                            <span t-if="record.init_type.raw_value" class="badge bg-light text-dark border small">
                                                <field name="init_type"/>
                                            </span>
                                            <span t-if="record.last_status.raw_value"
                                                  class="badge" t-att-class="{
                                                      'bg-success': record.last_status.raw_value == 'ok',
                                                      'bg-danger': record.last_status.raw_value == 'error',
                                                      'bg-warning text-dark': record.last_status.raw_value == 'skipped'
                                                  }">
                                                <field name="last_status"/>
                                            </span>
                                        </div>

                                        <!-- Right: run count + status -->
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span t-if="record.run_count.raw_value" class="text-muted small text-nowrap">
                                                <i class="fa fa-play-circle me-1"/>
                                                <field name="run_count"/>
                                            </span>
                                            <field name="status" widget="badge"
                                                   decoration-success="status=='active'"
                                                   decoration-warning="status=='draft'"
                                                   decoration-danger="status=='error'"
                                                   decoration-info="status=='done'"/>
                                        </div>
                                    </div>
                                </footer>
                            </main>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="ai_coworker_list" model="ir.ui.view">
        <field name="name">ai.coworker.list</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <list string="AI Medarbetare">
                <field name="name"/>
                <field name="init_type"/>
                <field name="status" widget="badge"
                       decoration-success="status=='active'"
                       decoration-warning="status=='draft'"/>
                <field name="agent_count"/>
                <field name="session_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="ai_coworker_search" model="ir.ui.view">
        <field name="name">ai.coworker.search</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <search string="Sök medarbetare">
                <field name="name"/>
                <field name="description"/>
                <field name="tag_ids"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <separator/>
                <filter string="Favorites" name="favorite" domain="[('is_favorite','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'init_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="ai_coworker_form" model="ir.ui.view">
        <field name="name">ai.coworker.form</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <form string="AI Medarbetare">
                <header>
                    <button name="action_open_builder" type="object" string="🤖 Build with AI" class="btn-primary"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet string="AI Medarbetare">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_agents" class="oe_stat_button" type="object" icon="fa-users">
                            <field name="agent_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_sessions" class="oe_stat_button" type="object" icon="fa-flag-checkered">
                            <field name="session_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_session_lines" class="oe_stat_button" type="object" icon="fa-money">
                            <field name="session_line_count" widget="statinfo" string="Tokens"/>
                        </button>
                        <button name="action_get_session_objects" class="oe_stat_button" type="object" icon="fa-puzzle-piece">
                            <field name="session_object_count" widget="statinfo" string="Objects"/>
                        </button>
                    </div>

                    <div class="oe_title d-flex align-items-start">
                        <div class="flex-grow-1 pe-3">
                            <h1><field name="name" placeholder="Namn på AI Medarbetare"/></h1>
                            <field name="sub_description" placeholder="Kort beskrivning"/>
                        </div>
                        <div class="flex-shrink-0">
                            <field name="partner_image_128" widget="image" class="oe_avatar"/>
                        </div>
                    </div>

                    <group>
                        <group string="Allmänt">
                            <field name="identity_id"/>
                            <field name="orchestration_mode" widget="radio"/>
                            <field name="orchestration_mode_help" readonly="1" class="text-muted" nolabel="1"/>
                            <field name="supervisor_model_id" invisible="orchestration_mode not in ('supervisor', 'buzz', 'conference')"/>
                            <field name="conference_mechanism" invisible="orchestration_mode != 'conference'"/>
                            <field name="max_iterations" invisible="orchestration_mode not in ('supervisor', 'buzz', 'linear', 'conference')"/>
                            <field name="min_confidence" invisible="orchestration_mode not in ('supervisor', 'buzz', 'conference')"/>
                            <field name="department_id"/>
                            <field name="is_default"/>
                            <field name="heartbeat_enabled"/>
                        </group>
                        <group string="Budget &amp; HITL">
                            <field name="hitl_threshold" widget="radio"/>
                            <field name="monthly_cap_mtokens"/>
                            <field name="budget_warning" readonly="1"/>
                            <field name="budget_exhausted" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="last_heartbeat" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description" name="description">
                            <group string="Beskrivning">
                                <field name="description" widget="html"/>
                                <field name="agent_creator_prompt" invisible="orchestration_mode != 'buzz'"/>
                                <field name="example_prompts"/>
                            </group>
                        </page>

                        <page string="Initiering" name="initiering">
                            <group>
                                <group>
                                    <field name="init_web_ui"/>
                                    <field name="init_chat"/>
                                    
                                  <!-- Channel -->  
                                    <field name="init_channel"/>
                                    <field name="channel_id" invisible="not init_channel" string=" → Discuss-kanal"/>
                                        <field name="response_mode" invisible="not init_chat and not init_channel" string=" → Svarar när"/>
                                        <field name="channel_reply_mode" invisible="not init_channel" string=" → Svarsläge"/>
                                        <field name="chat_trigger_words" invisible="init_channel or response_mode != 'trigger'" string=" → Aktiveringsord"/>
                                  <!-- Mail -->
                                    <field name="init_mail"/>
                                     <field name="alias_name" invisible="not init_mail" string=" → Mail-adress (alias)"/>
                                     <field name="alias_display" invisible="not init_mail" readonly="1" string=" → Full mailadress"/>
                                     <field name="alias_contact" invisible="not init_mail" string=" → Ta emot mail från"/>
                                     <button name="action_open_mail_alias" type="object"
                                         string=" → Öppna mail-alias" icon="fa-envelope-o"
                                         invisible="not init_mail" class="btn-link p-0"/>
                                     <button name="action_test_mail_flow" type="object"
                                         string=" → Testa mail-flödet" icon="fa-paper-plane-o"
                                         invisible="not init_mail" class="btn-link p-0"/>
                                     <field name="mail_action" invisible="not init_mail" string=" → Mail-åtgärd"/>
                                     <field name="mail_reply_delay" invisible="not init_mail" string=" → Svarsdröjsmål (min)"/>
                                     <field name="mail_target_model_id" invisible="not init_mail or mail_action != 'create_record'" string=" → Målmodell"/>
                                     <field name="mail_find_partner" invisible="not init_mail or mail_action != 'invoice_ai'" string=" → Hitta/skapa res.partner"/>
                                  <!-- Cron -->
                                    <field name="init_cron"/>
                                    <field name="cron_id" invisible="not init_cron" string="→ Schedule (ir.cron)" options="{'no_create': True}"/>
                                    <field name="cron_interval_number" invisible="not init_cron" string="→ Intervall"/>
                                    <field name="cron_interval_type" invisible="not init_cron" string="→ Intervalltyp"/>
                                    <field name="cron_model_id" invisible="not init_cron" string="→ Modell att filtrera"/>
                                    <field name="cron_model_name" invisible="1"/>
                                    <field name="filter_domain" widget="domain" options="{'model': 'cron_model_name'}" invisible="not init_cron" string="→ Filter (domän)"/>
                                    <field name="cron_automation_id" invisible="not init_cron" string="→ Schedule Action" readonly="1"/>
                                    
                                  <!-- Server Action -->
                                    <field name="init_server_action"/>
                                    <field name="server_action_id" invisible="not init_server_action" string="→ Server Action" options="{'no_create': True}"/>
                                    <field name="server_action_model_id" invisible="not init_server_action" string="→ Server Action-modell"/>
                                    <field name="server_action_model_name" invisible="1"/>
                                    <field name="server_action_use_wizard" invisible="not init_server_action" string="→ Visa prompt-wizard"/>
                                    <field name="server_action_automation_id" invisible="not init_server_action" string="→ Server Action (automation)" readonly="1"/>
                                </group>
                                <group>
									<!-- Powerbox -->
                                    <field name="init_powerbox"/>
                                    <field name="model_ids" invisible="not init_powerbox" widget="many2many_tags" string=" → Powerbox-modeller"/>
                                    <field name="init_manual"/>
                                    <field name="manual_call_instructions" invisible="not init_manual" nolabel="1"/>
                                    
                                    <!-- Webhook -->
                                    <field name="init_webhook"/>
                                        <field name="webhook_url" invisible="not init_webhook" string=" → Webhook URL" readonly="1"/>
                                        <field name="webhook_secret" invisible="not init_webhook" string=" → API-nyckel (secret)"/>
                                    <!-- OpenAI API -->
                                    <field name="init_openai_api"/>
                                        <field name="rate_limit_rpm" invisible="not init_openai_api" string=" → Rate limit (req/min)"/>
                                        <field name="rate_limit_tpm" invisible="not init_openai_api" string=" → Rate limit (tok/min)"/>
                                    <!-- Watch — kopia av base_automation-formuläret (minus notepad/Notes) -->
                                    <field name="init_watch"/>
                                    <field name="watch_model_name" invisible="1"/>
                                    <field name="watch_model_id" invisible="not init_watch" string=" → Apply on (modell)" options="{'no_create': True}"/>
                                    <label for="watch_trigger" string="When updating" invisible="not init_watch"/>
                                    <div invisible="not init_watch">
                                        <field name="watch_trigger" class="oe_inline me-3" options="{'no_open': True, 'no_create': True}"/>
                                        <field name="watch_trg_selection_field_id" placeholder="Select a value..." class="oe_inline"
                                            options="{'no_open': True, 'no_create': True}"
                                            invisible="watch_trigger not in ['on_state_set', 'on_priority_set']"
                                            required="watch_trigger in ['on_state_set', 'on_priority_set']"
                                        />
                                        <field name="watch_trg_field_ref" placeholder="Select a value..." class="oe_inline"
                                            options="{'no_open': True, 'no_create': True}"
                                            invisible="watch_trigger not in ['on_stage_set', 'on_tag_set']"
                                            required="watch_trigger in ['on_stage_set', 'on_tag_set']"
                                        />
                                        <field name="watch_trg_field_ref_model_name" invisible="1"/>
                                        <field name="watch_trg_date_id" class="oe_inline" string="Date Field"
                                            options="{'no_open': True, 'no_create': True}"
                                            invisible="watch_trigger != 'on_time'"
                                            required="watch_trigger in ['on_time', 'on_time_created', 'on_time_updated']"
                                        />
                                    </div>
                                    <label for="watch_trg_date_range" string="Delay" invisible="watch_trigger not in ['on_time', 'on_time_created', 'on_time_updated'] or not init_watch"/>
                                    <div class="d-flex flex-row gap-2" invisible="watch_trigger not in ['on_time', 'on_time_created', 'on_time_updated'] or not init_watch">
                                        <field name="watch_trg_date_range" class="oe_inline" required="watch_trigger in ['on_time', 'on_time_created', 'on_time_updated']"/>
                                        <field name="watch_trg_date_range_type" class="oe_inline" required="watch_trigger in ['on_time', 'on_time_created', 'on_time_updated']"/>
                                        <span invisible="watch_trigger != 'on_time_created'">after creation</span>
                                        <span invisible="watch_trigger != 'on_time_updated'">after last update</span>
                                        <span invisible="watch_trigger != 'on_time'">after</span>
                                        <field name="watch_trg_date_id" class="oe_inline" string="Date Field" placeholder="Select a date field..."
                                            options="{'no_open': True, 'no_create': True}"
                                            context="{'hide_model': 1}"
                                            invisible="watch_trigger != 'on_time'"
                                            required="watch_trigger in ['on_time', 'on_time_created', 'on_time_updated']"/>
                                    </div>
                                    <field name="watch_trg_date_calendar_id" class="oe_inline"
                                        options="{'no_open': True, 'no_create': True}"
                                        invisible="not watch_trg_date_id or watch_trg_date_range_type != 'day' or not init_watch"/>
                                    <field name="watch_filter_pre_domain" widget="domain"
                                        options="{'model': 'watch_model_name', 'in_dialog': True}"
                                        invisible="watch_trigger in ['on_create', 'on_unlink', 'on_change', 'on_webhook', 'on_time', 'on_time_created', 'on_time_updated'] or not init_watch"
                                        string=" → Before Update Domain"/>
                                    <field name="watch_filter_domain" widget="domain"
                                        options="{'model': 'watch_model_name', 'in_dialog': True}"
                                        invisible="watch_trigger in ['on_change', 'on_webhook'] or not init_watch"
                                        string=" → Apply on (domän)"/>
                                    <field name="watch_trigger_field_ids" string=" → When updating (fält)" placeholder="Select fields..."
                                        options="{'no_open': True, 'no_create': True}"
                                        domain="[('model_id', '=', watch_model_id),('store','=',True)]"
                                        context="{'hide_model': 1}"
                                        invisible="watch_trigger != 'on_create_or_write' or not init_watch" widget="many2many_tags"/>
                                    <field name="watch_on_change_field_ids" string=" → When updating (on change)" placeholder="Select fields..."
                                        options="{'no_open': True, 'no_create': True}"
                                        domain="[('model_id', '=', watch_model_id)]"
                                        context="{'hide_model': 1}"
                                        invisible="watch_trigger != 'on_change' or not init_watch" widget="many2many_tags"/>
                                    <field name="watch_active" widget="boolean_toggle" invisible="not init_watch" string=" → Aktiv (kör regel)"/>
                                    <field name="watch_domain" widget="domain" options="{'model': 'watch_model_name'}" invisible="not init_watch" string="→ Domän (filter i koden)"/>
                                    <field name="base_automation_id" invisible="not init_watch" string="→ Base Automation" readonly="1"/>
                                </group>

                                
                            </group>
                        </page>

                        <page string="Odoo Mind" name="odoo_mind">
                            <group string="Minnesprofil">
                                <field name="memory_profile" widget="radio"/>
                                <field name="memory_scopes" widget="many2many_tags"/>
                                <field name="memory_level" widget="radio"/>
                                <field name="learning" widget="radio"/>
                            </group>
                            <group string="Hermes Injection Level">
                                <field name="injection_level" widget="radio"/>
                            </group>
                            <group string="Företagsminne" invisible="'Företagets minne' in memory_scopes" >
                                <field name="inject_company_memory"/>
                                <field name="company_memory_artifact_types" widget="many2many_tags"/>
                                <field name="company_memory_categories" widget="many2many_tags"/>
                            </group>
                            <group string="Personligt &amp; Mission">
                                <field name="use_personal_info"/>
                                <field name="use_personal_lang"/>
                                <field name="use_company_info"/>
                                <field name="inject_nudging"/>
                            </group>
                            <group string="Rekordkontext">
                                <field name="context_injection_enabled"/>
                                <field name="context_max_fields"/>
                                <field name="context_include_chatter"/>
                                <field name="context_chatter_limit"/>
                                <field name="use_chat_history"/>
                                <field name="chat_history_limit"/>
                                <field name="use_time_context"/>
                            </group>
                        </page>

                        <page string="Agenter" name="agents">
                            <field name="agent_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="agent_id"/>
                                    <field name="agent_model_id"/>
                                    <field name="block_personal" string="🔒 Personligt"/>
                                    <field name="block_company" string="🔒 Företag"/>
                                    <field name="block_coworker" string="🔒 Medarbetare"/>
                                    <field name="level_personal" string="Nivå pe"/>
                                    <field name="level_company" string="Nivå co"/>
                                    <field name="level_coworker" string="Nivå cw"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>

                        <page string="Skills &amp; Tools" name="skills_tools">
                            <group>
                                <group string="Skills">
                                    <field name="skill_ids" widget="many2many_tags"/>
                                </group>
                                <group string="Verktyg">
                                    <field name="tool_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>

<!--
                        <page string="Sessions" name="sessions">
                            <field name="session_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="token_input" sum="1"/>
                                    <field name="token_output" sum="1"/>
                                    <field name="write_date"/>
                                </list>
                            </field>
                        </page>
-->

                        <page string="Åtkomst" name="access">
                            <group>
                                <group string="Användare &amp; grupper">
                                    <field name="group_ids" widget="many2many_tags"/>
                                    <field name="company_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>

