<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban with employee-style card -->
    <record id="ai_coworker_kanban" model="ir.ui.view">
        <field name="name">ai.coworker.kanban</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status" quick_create="false">
                <field name="name"/>
                <field name="sub_description"/>
                <field name="status"/>
                <field name="orchestration_mode"/>
                <field name="init_type"/>
                <field name="last_status"/>
                <field name="last_run"/>
                <field name="run_count"/>
                <field name="active"/>
                <field name="partner_image_128"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click d-flex flex-row"
                             t-att-class="{'border-danger border-2': !record.active.raw_value}">
                            <!-- Inactive ribbon -->
                            <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>

                            <!-- Image aside (partner → fallback) -->
                            <aside class="o_kanban_aside_full">
                                <t t-if="record.partner_image_128.raw_value">
                                    <field name="partner_image_128" widget="background_image"
                                           options="{'preview_image': 'partner_image_128'}" class="d-block position-relative"/>
                                </t>
                                <t t-else="">
                                    <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                         style="min-height: 100px;">
                                        <i class="fa fa-cubes fa-3x text-secondary opacity-50"/>
                                    </div>
                                </t>
                            </aside>

                            <!-- Main content -->
                            <main class="ms-2 d-flex flex-column" style="min-width: 0;">
                                <!-- Name -->
                                <div class="d-flex align-items-start">
                                    <strong class="fs-5 o_text_overflow">
                                        <field name="name"/>
                                    </strong>
                                </div>

                                <!-- Sub description (truncated) -->
                                <div class="text-muted small mt-0"
                                     style="max-height: 2.8em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"
                                     t-if="record.sub_description.raw_value">
                                    <field name="sub_description"/>
                                </div>

                                <!-- Footer -->
                                <footer class="mt-auto pt-2">
                                    <div class="d-flex justify-content-between align-items-end w-100">
                                        <!-- Left: badges -->
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span t-if="record.orchestration_mode.raw_value" class="badge"
                                                  t-att-class="{
                                                      'bg-primary': record.orchestration_mode.raw_value == 'single',
                                                      'bg-purple': record.orchestration_mode.raw_value == 'supervisor',
                                                      'bg-success': record.orchestration_mode.raw_value == 'buzz',
                                                      'bg-info': record.orchestration_mode.raw_value == 'linear',
                                                      'bg-warning': record.orchestration_mode.raw_value == 'conference',
                                                      'bg-secondary': record.orchestration_mode.raw_value == 'automation'
                                                  }">
                                                <field name="orchestration_mode"/>
                                            </span>
                                            <span t-if="record.init_type.raw_value" class="badge bg-light text-dark border small">
                                                <field name="init_type"/>
                                            </span>
                                            <span t-if="record.last_status.raw_value"
                                                  class="badge" t-att-class="{
                                                      'bg-success': record.last_status.raw_value == 'ok',
                                                      'bg-danger': record.last_status.raw_value == 'error',
                                                      'bg-warning text-dark': record.last_status.raw_value == 'skipped'
                                                  }">
                                                <field name="last_status"/>
                                            </span>
                                        </div>

                                        <!-- Right: run count + status -->
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span t-if="record.run_count.raw_value" class="text-muted small text-nowrap">
                                                <i class="fa fa-play-circle me-1"/>
                                                <field name="run_count"/>
                                            </span>
                                            <field name="status" widget="badge"
                                                   decoration-success="status=='active'"
                                                   decoration-warning="status=='draft'"
                                                   decoration-danger="status=='error'"
                                                   decoration-info="status=='done'"/>
                                        </div>
                                    </div>
                                </footer>
                            </main>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="ai_coworker_list" model="ir.ui.view">
        <field name="name">ai.coworker.list</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <list string="AI Quests">
                <field name="name"/>
                <field name="init_type"/>
                <field name="status" widget="badge"
                       decoration-success="status=='active'"
                       decoration-warning="status=='draft'"/>
                <field name="agent_count"/>
                <field name="session_count"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="ai_coworker_search" model="ir.ui.view">
        <field name="name">ai.coworker.search</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <search string="Search Quests">
                <field name="name"/>
                <field name="description"/>
                <field name="tag_ids"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="Draft" name="draft" domain="[('status','=','draft')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <separator/>
                <filter string="Favorites" name="favorite" domain="[('is_favorite','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by':'init_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="ai_coworker_form" model="ir.ui.view">
        <field name="name">ai.coworker.form</field>
        <field name="model">ai.coworker</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_builder" type="object"
                            string="🤖 Build with AI" class="btn-primary"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,done"/>
                </header>
                <sheet string="AI Quest">
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_agents" class="oe_stat_button"
                                type="object" icon="fa-users">
                            <field name="agent_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_sessions" class="oe_stat_button"
                                type="object" icon="fa-flag-checkered">
                            <field name="session_count" widget="statinfo"/>
                        </button>
                        <button name="action_get_session_lines" class="oe_stat_button"
                                type="object" icon="fa-money">
                            <field name="session_line_count" widget="statinfo"
                                   string="Tokens"/>
                        </button>
                        <button name="action_get_session_objects" class="oe_stat_button"
                                type="object" icon="fa-puzzle-piece">
                            <field name="session_object_count" widget="statinfo"
                                   string="Objects"/>
                        </button>
                    </div>

                    <!-- Titel + bild → bild till höger -->
                    <div class="oe_title d-flex align-items-start">
                        <div class="flex-grow-1 pe-3">
                            <h1><field name="name" placeholder="Quest Name"/></h1>
                            <field name="sub_description" placeholder="Short description"/>
                        </div>
                        <div class="flex-shrink-0">
                            <field name="partner_image_128" widget="image" class="oe_avatar"/>
                        </div>
                    </div>

                    <!-- Två kolumner under subtitle -->
                    <group col="2">
                        <group string="Settings">
                            <field name="orchestration_mode" widget="radio"/>
                            <field name="conference_mechanism"
                                   invisible="orchestration_mode != 'conference'"/>
                            <field name="injection_level" widget="radio"/>
                            <field name="identity_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Autonomi-panel (gap C5/F4)">
                            <field name="monthly_cap_mtokens"/>
                            <field name="budget_kr_monthly"/>
                            <field name="max_actions_per_day"/>
                            <field name="hitl_threshold" widget="radio"/>
                            <field name="heartbeat_enabled"/>
                        </group>
                        <group string="Configuration">
                            <field name="model_ids" widget="many2many_tags"/>
                            <field name="debug"/>
                            <field name="partner_id"/>
                        </group>
                    </group>

                    <!-- Initiering: kryssrutor per typ (many2many_checkboxes).
                         Visar endast DENNA medarbetares rader (domain på
                         coworker_id). active_test=False så även inaktiva
                         (avkryssade) typer syns som kryssrutor. Rader skapas/
                         aktiveras automatiskt via _inverse_active_init_types
                         + _ensure_all_init_types — ingen manuell hantering.
                         En av varje typ. -->
                    <group string="Initiering (init types)">
                        <field name="active_init_types"
                               widget="many2many_checkboxes"
                               domain="[('coworker_id', '=', id)]"
                               context="{'active_test': False}"
                               options="{'no_create': True, 'no_open': True}"
                               nolabel="1"/>
                    </group>

                    <!-- Init type config fields — syns när respektive typ är IKRYSSAD
                         (has_*-flaggor). Varje typ visar sina nödvändiga inställningar. -->
                    <group col="2" string="Typinställningar"
                           invisible="not has_web_ui and not has_chat and not has_channel
                                      and not has_mail and not has_cron
                                      and not has_server_action and not has_powerbox
                                      and not has_webhook and not has_openai_api
                                      and not has_watch">
                        <field name="has_web_ui" invisible="1"/>
                        <field name="has_chat" invisible="1"/>
                        <field name="has_channel" invisible="1"/>
                        <field name="has_mail" invisible="1"/>
                        <field name="has_cron" invisible="1"/>
                        <field name="has_server_action" invisible="1"/>
                        <field name="has_powerbox" invisible="1"/>
                        <field name="has_webhook" invisible="1"/>
                        <field name="has_openai_api" invisible="1"/>
                        <field name="has_watch" invisible="1"/>
                        <group>
                            <!-- Web Chat UI -->
                            <field name="show_in_chat"
                                   invisible="not has_web_ui" string="Visa i Web Chat"/>
                            <!-- Chat / Channel -->
                            <field name="channel_id"
                                   invisible="not has_channel" string="Discuss-kanal"/>
                            <field name="response_mode"
                                   invisible="not has_chat and not has_channel"
                                   string="Svarar när"/>
                            <field name="channel_reply_mode"
                                   invisible="not has_channel" string="Svarsläge"/>
                            <field name="chat_trigger_words"
                                   invisible="(not has_chat and not has_channel) or response_mode != 'trigger'"
                                   string="Aktiveringsord (kommaseparerade)"/>
                            <!-- Mail -->
                            <field name="alias_name" invisible="not has_mail" string="Mail-adress (alias)"/>
                            <field name="alias_contact" invisible="not has_mail" string="Ta emot mail från"/>
                            <!-- Webhook -->
                            <field name="webhook_url" invisible="not has_webhook" string="Webhook URL" readonly="1"/>
                            <field name="webhook_secret" invisible="not has_webhook" string="API-nyckel (secret)"/>
                            <field name="max_webhook_payload_size" invisible="not has_webhook" string="Max payload (bytes)"/>
                            <!-- Watch -->
                            <field name="watch_model_id" invisible="not has_watch" string="Bevaka modell"/>
                            <field name="watch_trigger" invisible="not has_watch" string="Trigger"/>
                            <field name="watch_domain" invisible="not has_watch" string="Domän (filter)"/>
                            <field name="base_automation_id" invisible="not has_watch" string="Base Automation" readonly="1"/>
                        </group>
                        <group>
                            <!-- Cron -->
                            <field name="cron_id" invisible="not has_cron" string="Schedule (ir.cron)"/>
                            <field name="cron_interval_number" invisible="not has_cron" string="Intervall"/>
                            <field name="cron_interval_type" invisible="not has_cron" string="Intervalltyp"/>
                            <field name="filter_domain" invisible="not has_cron" string="Filter (domän)"/>
                            <field name="notify_on_completion" invisible="not has_cron" string="Notifiera vid klar"/>
                            <!-- Server Action -->
                            <field name="server_action_id" invisible="not has_server_action" string="Server Action"/>
                            <field name="server_action_use_wizard" invisible="not has_server_action" string="Visa prompt-wizard"/>
                            <!-- OpenAI API -->
                            <field name="api_key_attachment_id" invisible="not has_openai_api" string="API-nyckel (bilaga)"/>
                            <field name="rate_limit_rpm" invisible="not has_openai_api" string="Rate limit (req/min)"/>
                            <field name="rate_limit_tpm" invisible="not has_openai_api" string="Rate limit (tok/min)"/>
                            <!-- Powerbox -->
                            <field name="model_ids" invisible="not has_powerbox"
                                   widget="many2many_tags" string="Powerbox-modeller"/>
                        </group>
                    </group>

                    <!-- Orchestration Type Config — syns baserat på vald mode -->
                    <group col="2" string="Orchestration Config"
                           invisible="orchestration_mode == 'single'">
                        <group>
                            <!-- Supervisor -->
                            <field name="max_iterations" invisible="orchestration_mode != 'supervisor'"/>
                            <field name="min_confidence" invisible="orchestration_mode != 'supervisor'"/>
                            <!-- Buzz -->
                            <field name="buzz_use_llm_router" invisible="orchestration_mode != 'buzz'"/>
                            <field name="buzz_a2a_max_depth" invisible="orchestration_mode != 'buzz'"/>
                            <field name="allow_auto_create_agents" invisible="orchestration_mode != 'buzz'"/>
                            <field name="max_auto_agents" invisible="orchestration_mode != 'buzz'"/>
                        </group>
                        <group>
                            <!-- Linear -->
                            <field name="pass_full_history" invisible="orchestration_mode != 'linear'"/>
                            <!-- Conference -->
                            <!-- Automation -->
                            <field name="notify_on_completion" invisible="orchestration_mode != 'automation'"/>
                            <field name="auto_allowed_tools" invisible="orchestration_mode != 'automation'"/>
                            <field name="auto_allowed_commands" invisible="orchestration_mode != 'automation'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Agenter" name="agents">
                            <field name="agent_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="agent_id" string="Agent"/>
                                    <field name="agent_model_id" string="Modell"/>
                                    <field name="agent_tools_display" string="Tools"/>
                                    <field name="agent_memories_display" string="Memories"/>
                                    <field name="role"/>
                                </list>
                            </field>
                        </page>

                        <page string="Description">
                            <field name="description" widget="text" nolabel="1"
                                   placeholder="System prompt / quest purpose..."/>
                            <field name="example_prompts" widget="text" nolabel="1"
                                   placeholder="Exempel-prompts per roll (gap A1/A3)..."/>
                        </page>

                        <page string="Context">
                            <group col="2">
                                <group string="Context Injection">
                                    <field name="context_injection_enabled"/>
                                    <field name="context_max_fields"
                                           invisible="not context_injection_enabled"/>
                                    <field name="context_include_chatter"
                                           invisible="not context_injection_enabled"/>
                                    <field name="context_chatter_limit"
                                           invisible="not context_injection_enabled or not context_include_chatter"/>
                                </group>
                                <group>
                                    <group string="Odoo Mind">
                                        <field name="use_chat_history"/>
                                        <field name="use_time_context"/>
                                        <field name="inject_nudging"/>
                                        <field name="inject_company_memory"/>
                                        <field name="company_memory_categories" widget="many2many_tags"/>
                                    </group>
                                    <group string="Company Info">
                                        <field name="use_company_info"/>
                                    </group>
                                    <group string="Personal Info">
                                        <field name="use_personal_info"/>
                                        <field name="use_personal_lang"/>
                                    </group>
                                </group>
                            </group>
                        </page>

                        <page string="Budget">
                            <group col="2">
                                <group string="Månadstak (Systemtokens)">
                                    <field name="monthly_cap_mtokens"
                                        help="0 = obegränsat. Tak i miljoner systemtokens.\nVid 80%: varning. Vid 100%: agenten pausas."/>
                                    <field name="session_line_count" readonly="1"
                                        string="Förbrukat denna månad"/>
                                    <field name="started_mtokens" readonly="1"
                                        string="Påbörjade M-tokens"/>
                                </group>
                                <group>
                                    <group string="All-time totals">
                                        <field name="total_sys_tokens" readonly="1"
                                            string="Totalt systemtokens"/>
                                        <field name="total_input_tokens" readonly="1"/>
                                        <field name="total_output_tokens" readonly="1"/>
                                        <field name="last_month_sys_tokens" readonly="1"
                                            string="Förra månaden"/>
                                    </group>
                                    <group string="Status">
                                        <field name="cap_warning_sent" readonly="1"
                                            invisible="not cap_warning_sent"/>
                                        <field name="cap_exhausted" readonly="1"
                                            invisible="not cap_exhausted"
                                            widget="boolean_toggle"/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
