<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_model_kanban" model="ir.ui.view">
        <field name="name">ai.model.kanban</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false" default_group_by="provider">
                <field name="name"/>
                <field name="display_name"/>
                <field name="provider"/>
                <field name="source_provider"/>
                <field name="provider_type"/>
                <field name="api_name"/>
                <field name="context_window"/>
                <field name="status"/>
                <field name="licence"/>
                <field name="cost_input_1k"/>
                <field name="cost_output_1k"/>
                <field name="is_vision"/>
                <field name="is_embedded"/>
                <field name="is_asr"/>
                <field name="is_text2image"/>
                <field name="has_tools"/>
                <field name="has_streaming"/>
                <field name="active"/>
                <field name="provider_image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click d-flex flex-row">
                            <!-- Image aside (provider → fallback) -->
                            <aside class="o_kanban_aside_full">
                                <t t-if="record.provider_image_128.raw_value">
                                    <field name="provider_image_128" widget="background_image"
                                           options="{'preview_image': 'provider_image_128'}" class="d-block position-relative"/>
                                </t>
                                <t t-else="">
                                    <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                         style="min-height: 100px;">
                                        <i class="fa fa-cogs fa-3x text-secondary opacity-50"/>
                                    </div>
                                </t>
                            </aside>

                            <!-- Main content -->
                            <main class="ms-2 d-flex flex-column" style="min-width: 0;">
                                <!-- Display name -->
                                <div class="d-flex align-items-start">
                                    <strong class="fs-5 o_text_overflow">
                                        <field name="display_name"/>
                                    </strong>
                                </div>

                                <!-- Provider + context window -->
                                <div class="text-muted small mt-0">
                                    <field name="provider"/>
                                    · <field name="context_window"/>K context
                                </div>

                                <!-- Wire-id (api_name) -->
                                <div class="text-muted small" t-if="record.api_name.raw_value">
                                    wire: <field name="api_name"/>
                                </div>

                                <!-- Cost: input / output per 1K -->
                                <div class="text-muted small" t-if="record.cost_input_1k.raw_value">
                                    <i class="fa fa-usd me-1"/><field name="cost_input_1k"/> / <field name="cost_output_1k"/> per 1K
                                </div>

                                <!-- Footer -->
                                <footer class="mt-auto pt-2">
                                    <div class="d-flex justify-content-between align-items-end w-100">
                                        <!-- Left: capability icons + badges -->
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <!-- Capability icons -->
                                            <span class="fa fa-eye text-success" t-if="record.is_vision.raw_value" title="Vision"/>
                                            <span class="fa fa-cog text-primary" t-if="record.has_tools.raw_value" title="Tool Calling"/>
                                            <span class="fa fa-comment text-info" t-if="record.is_asr.raw_value" title="Speech-to-Text"/>
                                            <span class="fa fa-picture-o text-warning" t-if="record.is_text2image.raw_value" title="Text-to-Image"/>
                                            <span class="fa fa-database text-secondary" t-if="record.is_embedded.raw_value" title="Embedding"/>
                                            <span class="fa fa-bolt text-danger" t-if="record.has_streaming.raw_value" title="Streaming"/>

                                            <!-- Cost badge: input / output -->
                                            <span t-if="record.cost_input_1k.raw_value" class="badge bg-success small d-inline-flex align-items-center gap-1">
                                                <i class="fa fa-usd"/><field name="cost_input_1k"/> / <field name="cost_output_1k"/>
                                            </span>

                                            <!-- Licence badge -->
                                            <span t-if="record.licence.raw_value" class="badge bg-light text-dark border small">
                                                <field name="licence"/>
                                            </span>

                                            <!-- Maker badge (tillverkare) -->
                                            <span t-if="record.source_provider.raw_value" class="badge bg-info text-white small" title="Tillverkare">
                                                <i class="fa fa-industry me-1"/><field name="source_provider"/>
                                            </span>
                                        </div>

                                        <!-- Right: status -->
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <field name="status" widget="badge"
                                                   decoration-success="status=='active'"
                                                   decoration-warning="status=='beta'"
                                                   decoration-danger="status=='deprecated'"/>
                                        </div>
                                    </div>
                                </footer>
                            </main>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_model_list" model="ir.ui.view">
        <field name="name">ai.model.list</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <list string="Models" decoration-danger="status=='deprecated'" multi_edit="1">
                <field name="name"/>
                <field name="api_name" optional="show"/>
                <field name="provider"/>
                <field name="source_provider" optional="show"/>
                <field name="real_provider" optional="show"/>
                <field name="context_window"/>
                <field name="max_output_tokens" optional="hide"/>
                <field name="is_vision"/>
                <field name="has_tools"/>
                <field name="is_embedded"/>
                <field name="is_asr"/>
                <field name="is_text2image"/>
                <field name="cost_input_1k" optional="hide"/>
                <field name="cost_output_1k" optional="hide"/>
                <field name="sys_multiplier" optional="hide"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ai_model_search" model="ir.ui.view">
        <field name="name">ai.model.search</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <search string="Search Models">
                <field name="name"/>
                <field name="provider"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="Vision" name="vision" domain="[('is_vision','=',True)]"/>
                <filter string="Tool Calling" name="tools" domain="[('has_tools','=',True)]"/>
                <filter string="Streaming" name="streaming" domain="[('has_streaming','=',True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Provider" name="group_provider" context="{'group_by':'provider'}"/>
                    <filter string="Source Provider (tillverkare)" name="group_source_provider" context="{'group_by':'source_provider'}"/>
                    <filter string="Provider Type" name="group_provider_type" context="{'group_by':'provider_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    <filter string="Licence" name="group_licence" context="{'group_by':'licence'}"/>
                    <filter string="Vision" name="group_vision" context="{'group_by':'is_vision'}"/>
                    <filter string="Embedding" name="group_embed" context="{'group_by':'is_embedded'}"/>
                    <filter string="Tool Calling" name="group_tools" context="{'group_by':'has_tools'}"/>
                    <filter string="Streaming" name="group_stream" context="{'group_by':'has_streaming'}"/>
                    <filter string="Active" name="group_active" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_model_form" model="ir.ui.view">
        <field name="name">ai.model.form</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,beta,deprecated" clickable="True"/>
                </header>
                <sheet>
                    <!-- D2: Stat-buttons — llm_count = antal ai.agent som använder modellen;
                         session_line_count = rader vars model_real matchar name/api_name -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_llms" type="object"
                                class="oe_stat_button" icon="fa-microchip">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Agenter</span>
                                <span class="o_stat_value"><field name="llm_count" widget="statinfo"/></span>
                            </div>
                        </button>
                        <button name="action_open_session_lines" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sessioner</span>
                                <span class="o_stat_value"><field name="session_line_count" widget="statinfo"/></span>
                            </div>
                        </button>
                    </div>

                    <!-- Bild: avatar från provider (mönster från gamla ai.agent.llm image_128 oe_avatar) -->
                    <field name="provider_image_128" widget="image" class="oe_avatar"/>

                    <!-- D3: Titel -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. gpt-4o"/>
                        </h1>
                        <h2>
                            <field name="provider"/>
                        </h2>
                    </div>

                    <!-- D4: Huvudgrupper -->
                    <group>
                        <group string="Status">
                            <field name="status" widget="badge"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="licence"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Provider">
                            <field name="api_name"/>
                            <field name="source_provider"/>
                            <field name="real_provider" readonly="1"/>
                            <field name="provider_type" readonly="1"/>
                        </group>
                    </group>

                    <!-- D5: Notebook -->
                    <notebook>
                        <page string="Capabilities" name="capabilities">
                            <group>
                                <group string="Vision &amp; Media">
                                    <field name="is_vision" widget="boolean_toggle"/>
                                    <field name="is_embedded" widget="boolean_toggle"/>
                                    <field name="is_asr" widget="boolean_toggle"/>
                                    <field name="is_text2image" widget="boolean_toggle"/>
                                </group>
                                <group string="Inference">
                                    <field name="has_tools" widget="boolean_toggle"/>
                                    <field name="has_json_mode" widget="boolean_toggle"/>
                                    <field name="has_streaming" widget="boolean_toggle"/>
                                </group>
                            </group>
                        </page>
                        <page string="Context &amp; Cost" name="context_cost">
                            <group>
                                <group string="Context">
                                    <field name="context_window"/>
                                    <field name="max_output_tokens"/>
                                </group>
                                <group string="Cost (per 1K tokens)">
                                    <field name="cost_input_1k"/>
                                    <field name="cost_output_1k"/>
                                </group>
                            </group>
                        </page>
                        <page string="Systemtoken" name="systemtoken">
                            <group string="Pricing">
                                <field name="sys_multiplier"
                                       help="How many systemtokens 1 real token costs. Includes Vertel margin."/>
                                <field name="provider_cost_1M"
                                       help="What the provider charges per 1M tokens. Admin insight only."/>
                            </group>
                        </page>
                        <page string="Usage" name="usage">
                            <group string="Användning">
                                <field name="llm_count" readonly="1"/>
                                <field name="session_line_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
