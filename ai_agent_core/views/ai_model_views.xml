<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_model_kanban" model="ir.ui.view">
        <field name="name">ai.model.kanban</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="display_name"/>
                <field name="provider_id"/>
                <field name="context_window"/>
                <field name="status"/>
                <field name="is_vision"/>
                <field name="is_embedded"/>
                <field name="is_asr"/>
                <field name="is_text2image"/>
                <field name="has_tools"/>
                <field name="has_streaming"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="o_kanban_card_header">
                                <strong><field name="display_name"/></strong>
                            </div>
                            <div class="o_kanban_card_content">
                                <div class="text-muted small">
                                    <field name="provider_id"/>
                                    · <field name="context_window"/>K
                                </div>
                            </div>
                            <div class="o_kanban_card_footer">
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <div>
                                        <span class="fa fa-eye" t-if="record.is_vision.raw_value" title="Vision"/>
                                        <span class="fa fa-cog" t-if="record.has_tools.raw_value" title="Tool Calling"/>
                                        <span class="fa fa-comment" t-if="record.is_asr.raw_value" title="Speech-to-Text"/>
                                        <span class="fa fa-file-photo-o" t-if="record.is_text2image.raw_value" title="Text-to-Image"/>
                                    </div>
                                    <field name="status" widget="badge"
                                           decoration-success="status=='active'"
                                           decoration-warning="status=='beta'"
                                           decoration-danger="status=='deprecated'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_model_list" model="ir.ui.view">
        <field name="name">ai.model.list</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <list string="Models" decoration-danger="status=='deprecated'" multi_edit="1">
                <field name="name"/>
                <field name="provider_id"/>
                <field name="context_window"/>
                <field name="max_output_tokens" optional="hide"/>
                <field name="is_vision"/>
                <field name="has_tools"/>
                <field name="is_embedded"/>
                <field name="is_asr"/>
                <field name="is_text2image"/>
                <field name="cost_input_1k" optional="hide"/>
                <field name="cost_output_1k" optional="hide"/>
                <field name="sys_multiplier" optional="hide"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="ai_model_search" model="ir.ui.view">
        <field name="name">ai.model.search</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <search string="Search Models">
                <field name="name"/>
                <field name="provider_id"/>
                <filter string="Active" name="active" domain="[('status','=','active')]"/>
                <filter string="Vision" name="vision" domain="[('is_vision','=',True)]"/>
                <filter string="Tool Calling" name="tools" domain="[('has_tools','=',True)]"/>
                <filter string="Streaming" name="streaming" domain="[('has_streaming','=',True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Provider" name="group_provider" context="{'group_by':'provider_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="ai_model_form" model="ir.ui.view">
        <field name="name">ai.model.form</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                        <h2><field name="provider_id"/></h2>
                    </div>
                    <group col="2">
                        <field name="name"/>
                        <field name="status"/>
                    </group>
                    <notebook>
                        <page string="Capabilities">
                            <group col="4">
                                <field name="is_vision" widget="boolean_toggle"/>
                                <field name="is_embedded" widget="boolean_toggle"/>
                                <field name="is_asr" widget="boolean_toggle"/>
                                <field name="is_text2image" widget="boolean_toggle"/>
                                <field name="has_tools" widget="boolean_toggle"/>
                                <field name="has_json_mode" widget="boolean_toggle"/>
                                <field name="has_streaming" widget="boolean_toggle"/>
                            </group>
                        </page>
                        <page string="Context &amp; Cost">
                            <group>
                                <field name="context_window"/>
                                <field name="max_output_tokens"/>
                            </group>
                            <group string="Cost (per 1K tokens)">
                                <field name="cost_input_1k"/>
                                <field name="cost_output_1k"/>
                            </group>
                        </page>
                        <page string="Systemtoken">
                            <group string="Pricing">
                                <field name="sys_multiplier"
                                    help="How many systemtokens 1 real token costs. Includes Vertel margin."/>
                                <field name="provider_cost_1M"
                                    help="What the provider charges per 1M tokens. Admin insight only."/>
                            </group>
                        </page>
                        <page string="License">
                            <group>
                                <field name="licence"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
