<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_session_search" model="ir.ui.view">
        <field name="name">ai.coworker.session.search</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <search string="Sessioner">
                <field name="name"/>
                <field name="user_id"/>
                <field name="coworker_id"/>
                <field name="partner_id"/>
                <field name="pi_session_id"/>
                <separator/>
                <filter name="my_sessions" string="Mina sessioner"
                        domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="today" string="Idag"
                        domain="[('create_date','&gt;=',context_today())]"/>
                <filter name="last_7_days" string="Senaste 7 dagar"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=7))]"/>
                <filter name="last_30_days" string="Senaste 30 dagar"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=30))]"/>
                <!-- OBS: använder INTE .weekday()/.replace() i domäner — de kraschar
                     i Odoo-webklientens domän-evaluator (fnValue is not a function). -->
                <separator/>
                <filter name="has_record_context" string="Med rekordkontext"
                        domain="[('ai_record_model','!=',False)]"/>
                <filter name="has_multi_record" string="With selection"
                        domain="[('ai_record_ids','!=',False)]"/>
                <separator/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_started" string="Started"
                            context="{'group_by':'create_date'}"/>
                    <filter name="group_ended" string="Ended"
                            context="{'group_by':'end_date'}"/>
                    <filter name="group_partner" string="Kund"
                            context="{'group_by':'partner_id'}"/>
                    <filter name="group_record_model" string="Record model"
                            context="{'group_by':'ai_record_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_session_tree" model="ir.ui.view">
        <field name="name">ai.coworker.session.tree</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id" optional="show"/>
                <field name="name"/>
                <field name="coworker_id" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status=='done'"
                       decoration-warning="status=='active'"/>
                <field name="init_type" optional="show"/>
                <field name="ai_record_model" optional="hide"/>
                <field name="ai_record_count" optional="hide" sum="1"/>
                <field name="user_rating" optional="hide"/>
                <field name="error_detail" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <!-- Kund-kolumnen (partner_id) ägs av project_ai-ext-vyn (6257),
                     så core-listan deklarerar den INTE (annars blir det dubbel). -->
                <field name="end_date" optional="show"/>
                <field name="token_input" optional="hide"/>
                <field name="token_output" optional="hide"/>
                <field name="token_sys" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_session_form" model="ir.ui.view">
        <field name="name">ai.coworker.session.form</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <form string="AI Session">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,done,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_lines" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <field name="line_count" widget="statinfo"
                                       string="Meddelanden"/>
                            </div>
                        </button>
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <div class="o_stat_info">
                                <field name="attachment_count" widget="statinfo"
                                       string="Bilagor"/>
                            </div>
                        </button>
                        <button name="action_open_hitl" type="object"
                                class="oe_stat_button" icon="fa-hand-paper"
                                invisible="hitl_open_count == 0">
                            <div class="o_stat_info">
                                <field name="hitl_open_count" widget="statinfo"
                                       string="HITL"/>
                            </div>
                        </button>
                        <button name="action_abort_external" type="object"
                                class="oe_stat_button" icon="fa-stop-circle"
                                invisible="external_pid == 0"
                                confirm="Avbryt den externa körningen (SIGTERM → SIGKILL)?">
                            <div class="o_stat_info">
                                <span class="o_stat_value">Avbryt</span>
                                <span class="o_stat_text">extern körning</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Trådnamn..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="coworker_id" readonly="1"/>
                            <field name="identity_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="init_type" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="ai_task_id" readonly="1"/>
                            <field name="user_rating" placeholder="Bedöm svaret…"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="end_date" readonly="1" />
                            <field name="finish_reason" readonly="1"/>
                            <field name="token_input" readonly="1"/>
                            <field name="token_output" readonly="1"/>
                            <field name="token_sys" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="resumable" readonly="1"/>
                        </group>
                    </group>
                    <!-- Rekordkontext (ai-coworker-record-context): vilken
                         record — eller vilken markering — denna tur gällde.
                         Singular (form-vy) sätter ai_record_id/json/chatter;
                         plural (list-vy) sätter ai_record_ids/records_json. -->
                    <group string="Record context" invisible="not ai_record_model">
                        <field name="ai_record_model" readonly="1"/>
                        <field name="ai_record_id" readonly="1"
                               invisible="not ai_record_id"/>
                        <field name="ai_record_count" readonly="1"
                               invisible="not ai_record_count"/>
                        <field name="ai_record_ids" readonly="1"
                               invisible="not ai_record_ids"/>
                    </group>
                    <!-- Extern körning (external-agent-runtime D10): mätpunkten.
                         Tröskeln för samtidighet är empirisk och sätts inte nu —
                         men profilen ska kunna avläsas när frågan uppstår. -->
                    <group string="Extern körning" invisible="external_pid == 0">
                        <field name="external_pid" readonly="1"/>
                        <field name="external_port" readonly="1"/>
                        <field name="external_started_at" readonly="1"/>
                        <field name="external_spawn_time" readonly="1"
                               widget="float_time"/>
                        <field name="external_rss_kb" readonly="1"/>
                        <field name="external_duration" readonly="1"
                               widget="float_time"/>
                    </group>
                    <field name="error_detail" readonly="1" placeholder="Felbeskrivning…"/>
                    <notebook>
                        <page string="Sammanfattning" name="summary">
                            <group>
                                <field name="summary" readonly="1"/>
                                <field name="summary_message_count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Record context" name="record_context"
                              invisible="not ai_record_model">
                            <group>
                                <field name="ai_record_model" readonly="1"/>
                                <field name="ai_record_id" readonly="1"/>
                                <field name="ai_record_count" readonly="1"/>
                                <field name="ai_record_ids" readonly="1"/>
                            </group>
                            <group string="Fields (singular)"
                                   invisible="not ai_record_json">
                                <field name="ai_record_json" readonly="1"/>
                            </group>
                            <group string="Fields (selection)"
                                   invisible="not ai_records_json">
                                <field name="ai_records_json" readonly="1"/>
                            </group>
                            <group string="Chatter"
                                   invisible="not ai_record_chatter">
                                <field name="ai_record_chatter" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Odoo 18 chatter: visar mail/meddelanden på tråden
                     (message_new + _post_pending_reply postar här) -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_session_line_list" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.list</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <list string="Meddelanden">
                <field name="create_date"/>
                <field name="role" widget="badge"
                       decoration-info="role=='assistant'"
                       decoration-muted="role=='user'"/>
                <field name="content"/>
                <field name="agent_id" optional="hide"/>
                <field name="tool_id" optional="hide"/>
                <field name="tool_name" optional="hide"/>
                <field name="skill_id" optional="hide"/>
                <field name="model_real" optional="hide"/>
                <field name="reasoning" optional="hide"/>
                <field name="token_input" optional="show" sum="1"/>
                <field name="token_output" optional="show" sum="1"/>
                <field name="token_sys" optional="show" sum="1"/>
            </list>
        </field>
    </record>

    <record id="view_ai_session_line_form" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.form</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <form string="Meddelande">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="agent_id" readonly="1"/>
                            <field name="skill_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="tool_id" readonly="1"/>
                            <field name="model_real" readonly="1"/>
                            <field name="tool_name" readonly="1"/>
                            <field name="token_input" readonly="1"/>
                            <field name="token_output" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Innehåll" name="content">
                            <field name="content" readonly="1"/>
                        </page>
                        <page string="Tänkande (reasoning)" name="reasoning"
                              invisible="not reasoning">
                            <field name="reasoning" readonly="1"/>
                        </page>
                        <page string="Resonemang (debug)" name="debug"
                              invisible="not debug_info">
                            <field name="debug_info" readonly="1"/>
                        </page>
                        <page string="Källor" name="sources"
                              invisible="not source_urls">
                            <field name="source_urls" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search/filter & gruppering för session-line (message) listan:
         Idag / Denna vecka / Denna månad. OBS: webb-säker domän — bara
         context_today() ± datetime.timedelta(days=KONST) (inga .weekday/.replace,
         de kraschar klientens domän-evaluator). "Denna vecka/månad" används som
         rullande fönster (7/30 dagar) för att förbli klient-säker. -->
    <record id="view_ai_session_line_search" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.search</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <search string="Meddelanden">
                <field name="content"/>
                <field name="session_id"/>
                <field name="role"/>
                <field name="agent_id"/>
                <field name="tool_id"/>
                <field name="model_real"/>
                <separator/>
                <filter name="today" string="Idag"
                        domain="[('create_date','&gt;=',context_today())]"/>
                <filter name="this_week" string="Denna vecka (7d)"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=7))]"/>
                <filter name="this_month" string="Denna månad (30d)"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=30))]"/>
                <separator/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_date" string="Datum"
                            context="{'group_by':'create_date'}"/>
                    <filter name="group_role" string="Roll"
                            context="{'group_by':'role'}"/>
                    <filter name="group_agent" string="Agent"
                            context="{'group_by':'agent_id'}"/>
                    <filter name="group_model" string="Modell"
                            context="{'group_by':'model_real'}"/>
                    <filter name="group_tool" string="Verktyg"
                            context="{'group_by':'tool_id'}"/>
                    <filter name="group_session" string="Tråd"
                            context="{'group_by':'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action definieras sist: den ref:ar view_ai_session_search,
         som måste existera innan actionn laddas (external-ID-ordning). -->
    <record id="action_ai_coworker_session" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">ai.coworker.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_session_search"/>
        <!-- Default: visa bara den inloggade användarens egna sessioner -->
        <field name="context">{'search_default_my_sessions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sessioner registreras automatiskt när AI-medarbetare samtalar.
            </p>
        </field>
    </record>

</odoo>
