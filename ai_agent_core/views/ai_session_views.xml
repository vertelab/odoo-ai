<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_session_search" model="ir.ui.view">
        <field name="name">ai.coworker.session.search</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <search string="Sessioner">
                <field name="name"/>
                <field name="user_id"/>
                <field name="coworker_id"/>
                <field name="partner_id"/>
                <field name="pi_session_id"/>
                <separator/>
                <filter name="my_sessions" string="Mina sessioner"
                        domain="[('user_id','=',uid)]"/>
                <separator/>
                <filter name="today" string="Idag"
                        domain="[('create_date','&gt;=',context_today())]"/>
                <filter name="last_7_days" string="Senaste 7 dagar"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=7))]"/>
                <filter name="last_30_days" string="Senaste 30 dagar"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=30))]"/>
                <!-- Månadsfiltret är SAMMA definition som räknaren på
                     ai.coworker använder (`_session_domain(id,'this_month')`:
                     create_date >= första dagen i innevarande kalendermånad).
                     Det öppnas som FÖRVALT filter från smartknappen
                     (coworker-session-smart-button) — månaden är en synlig,
                     borttagbar avgränsning, aldrig ett tak i domänen.
                     Namnet `this_month` MÅSTE matcha `search_default_this_month`
                     i action_get_sessions; ett stavfel ger tyst ofiltrerad lista. -->
                <filter name="this_month" string="This Month"
                        domain="[('create_date','&gt;=', context_today() - relativedelta(day=1, hour=0, minute=0, second=0))]"/>
                <filter name="last_month" string="Last Month"
                        domain="[('create_date','&gt;=', context_today() - relativedelta(months=1, day=1, hour=0, minute=0, second=0)),('create_date','&lt;', context_today() - relativedelta(day=1, hour=0, minute=0, second=0))]"/>
                <!-- OBS: använder INTE .weekday()/.replace() i domäner — de kraschar
                     i Odoo-webklientens domän-evaluator (fnValue is not a function).
                     `relativedelta(day=1)` är idiomets säkra form (jfr OCA
                     hr_attendance_full_history, mgmtsystem_sam). -->
                <separator/>
                <filter name="has_record_context" string="Med rekordkontext"
                        domain="[('ai_record_model','!=',False)]"/>
                <filter name="has_multi_record" string="With selection"
                        domain="[('ai_record_ids','!=',False)]"/>
                <separator/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_started" string="Started"
                            context="{'group_by':'create_date'}"/>
                    <!-- Månadsgruppering: den billigaste vägen till "hur såg
                         augusti ut?" (coworker-session-smart-button D5). -->
                    <filter name="group_by_month" string="Month"
                            context="{'group_by':'create_date:month'}"/>
                    <filter name="group_status" string="Status"
                            context="{'group_by':'status'}"/>
                    <filter name="group_init_type" string="Start via"
                            context="{'group_by':'init_type'}"/>
                    <!-- Sessionens användare är grupperbar (sessions-specen):
                         en grupp per användare, användarlösa sessioner hamnar i
                         en synlig "(inget)"-grupp. user_id är indexerat. -->
                    <filter name="group_user" string="User"
                            context="{'group_by':'user_id'}"/>
                    <filter name="group_ended" string="Ended"
                            context="{'group_by':'end_date'}"/>
                    <filter name="group_partner" string="Kund"
                            context="{'group_by':'partner_id'}"/>
                    <filter name="group_record_model" string="Record model"
                            context="{'group_by':'ai_record_model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ai_session_tree" model="ir.ui.view">
        <field name="name">ai.coworker.session.tree</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="user_id" optional="show"/>
                <field name="name"/>
                <field name="coworker_id" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status=='done'"
                       decoration-warning="status=='active'"/>
                <field name="init_type" optional="show"/>
                <field name="ai_record_model" optional="hide"/>
                <field name="ai_record_count" optional="hide" sum="1"/>
                <field name="user_rating" optional="hide"/>
                <field name="error_detail" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <!-- Kund-kolumnen (partner_id) ägs av project_ai-ext-vyn (6257),
                     så core-listan deklarerar den INTE (annars blir det dubbel). -->
                <field name="end_date" optional="show"/>
                <field name="token_input" optional="hide"/>
                <field name="token_output" optional="hide"/>
                <field name="token_sys" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_session_form" model="ir.ui.view">
        <field name="name">ai.coworker.session.form</field>
        <field name="model">ai.coworker.session</field>
        <field name="arch" type="xml">
            <form string="AI Session">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,done,error"/>
                    <!-- Befordran till eval-fall (wire-orphaned-core-mechanisms
                         4.3): bara för sessioner som SLUTADE dåligt. En
                         lyckad session är inte ett regressionstest, och
                         knappen ska inte erbjuda det. -->
                    <button name="action_promote_to_eval_case" type="object"
                            string="Promote to Eval Case"
                            class="btn-primary"
                            invisible="finish_reason not in ['error', 'max_rounds', 'length', 'timeout']"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_lines" type="object"
                                class="oe_stat_button" icon="fa-comments">
                            <div class="o_stat_info">
                                <field name="line_count" widget="statinfo"
                                       string="Meddelanden"/>
                            </div>
                        </button>
                        <button name="action_open_attachments" type="object"
                                class="oe_stat_button" icon="fa-paperclip">
                            <div class="o_stat_info">
                                <field name="attachment_count" widget="statinfo"
                                       string="Bilagor"/>
                            </div>
                        </button>
                        <button name="action_open_hitl" type="object"
                                class="oe_stat_button" icon="fa-hand-paper"
                                invisible="hitl_open_count == 0">
                            <div class="o_stat_info">
                                <field name="hitl_open_count" widget="statinfo"
                                       string="HITL"/>
                            </div>
                        </button>
                        <button name="action_abort_external" type="object"
                                class="oe_stat_button" icon="fa-stop-circle"
                                invisible="external_pid == 0"
                                confirm="Abort the external run (SIGTERM → SIGKILL)?">
                            <div class="o_stat_info">
                                <span class="o_stat_value">Avbryt</span>
                                <span class="o_stat_text">external run</span>
                            </div>
                        </button>
                        <!-- Spåret (session-observability): vad som GJORDES,
                             inte bara vad som sades. Räknarna läser
                             agent_run/tool_call — ingen budget påverkas. -->
                        <button name="action_open_agent_runs" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="agent_run_count == 0">
                            <div class="o_stat_info">
                                <field name="agent_run_count"
                                       widget="statinfo" string="Runs"/>
                            </div>
                        </button>
                        <button name="action_open_tool_calls" type="object"
                                class="oe_stat_button" icon="fa-wrench"
                                invisible="tool_call_count == 0">
                            <div class="o_stat_info">
                                <field name="tool_call_count"
                                       widget="statinfo" string="Tools"/>
                            </div>
                        </button>
                        <button name="action_open_close_events" type="object"
                                class="oe_stat_button" icon="fa-flag-checkered"
                                invisible="close_event_count == 0">
                            <div class="o_stat_info">
                                <field name="close_event_count"
                                       widget="statinfo" string="Close Events"/>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Thread name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="coworker_id" readonly="1"/>
                            <field name="identity_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="init_type" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="ai_task_id" readonly="1"/>
                            <field name="user_rating" placeholder="Rate the answer…"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="end_date" readonly="1" />
                            <field name="finish_reason" readonly="1"/>
                            <field name="token_input" readonly="1"/>
                            <field name="token_output" readonly="1"/>
                            <field name="token_sys" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="resumable" readonly="1"/>
                        </group>
                    </group>
                    <!-- Livscykel + spår-översikt (session-observability):
                         en blick ska räcka för att se hur sessionen
                         startade, slutade och vad den gjorde. -->
                    <group>
                        <group string="Lifecycle">
                            <field name="start_reason" readonly="1"/>
                            <field name="last_close_reason" readonly="1"
                                   invisible="close_event_count == 0"/>
                            <field name="last_close_at" readonly="1"
                                   invisible="close_event_count == 0"/>
                        </group>
                        <group string="Trace (work, not budget)"
                               invisible="agent_run_count == 0 and tool_call_count == 0">
                            <field name="trace_agent_count" readonly="1"/>
                            <field name="agent_run_count" readonly="1"/>
                            <field name="tool_call_count" readonly="1"/>
                            <field name="tool_error_count" readonly="1"
                                   decoration-danger="tool_error_count &gt; 0"/>
                        </group>
                    </group>
                    <!-- Rekordkontext (ai-coworker-record-context): vilken
                         record — eller vilken markering — denna tur gällde.
                         Singular (form-vy) sätter ai_record_id/json/chatter;
                         plural (list-vy) sätter ai_record_ids/records_json. -->
                    <group string="Record context" invisible="not ai_record_model">
                        <field name="ai_record_model" readonly="1"/>
                        <field name="ai_record_id" readonly="1"
                               invisible="not ai_record_id"/>
                        <field name="ai_record_count" readonly="1"
                               invisible="not ai_record_count"/>
                        <field name="ai_record_ids" readonly="1"
                               invisible="not ai_record_ids"/>
                    </group>
                    <!-- Extern körning (external-agent-runtime D10): mätpunkten.
                         Tröskeln för samtidighet är empirisk och sätts inte nu —
                         men profilen ska kunna avläsas när frågan uppstår. -->
                    <group string="External Run" invisible="external_pid == 0">
                        <field name="external_pid" readonly="1"/>
                        <field name="external_port" readonly="1"/>
                        <field name="external_started_at" readonly="1"/>
                        <field name="external_spawn_time" readonly="1"
                               widget="float_time"/>
                        <field name="external_rss_kb" readonly="1"/>
                        <field name="external_duration" readonly="1"
                               widget="float_time"/>
                    </group>
                    <field name="error_detail" readonly="1" placeholder="Felbeskrivning…"/>
                    <notebook>
                        <page string="Sammanfattning" name="summary">
                            <group>
                                <field name="summary" readonly="1"/>
                                <field name="summary_message_count" readonly="1"/>
                            </group>
                        </page>
                        <page string="Record context" name="record_context"
                              invisible="not ai_record_model">
                            <group>
                                <field name="ai_record_model" readonly="1"/>
                                <field name="ai_record_id" readonly="1"/>
                                <field name="ai_record_count" readonly="1"/>
                                <field name="ai_record_ids" readonly="1"/>
                            </group>
                            <group string="Fields (singular)"
                                   invisible="not ai_record_json">
                                <field name="ai_record_json" readonly="1"/>
                            </group>
                            <group string="Fields (selection)"
                                   invisible="not ai_records_json">
                                <field name="ai_records_json" readonly="1"/>
                            </group>
                            <group string="Chatter"
                                   invisible="not ai_record_chatter">
                                <field name="ai_record_chatter" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- Odoo 18 chatter: visar mail/meddelanden på tråden
                     (message_new + _post_pending_reply postar här) -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_session_line_list" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.list</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <list string="Meddelanden">
                <field name="create_date"/>
                <field name="role" widget="badge"
                       decoration-info="role=='assistant'"
                       decoration-muted="role=='user'"/>
                <field name="content"/>
                <field name="agent_id" optional="hide"/>
                <field name="tool_id" optional="hide"/>
                <field name="tool_name" optional="hide"/>
                <field name="skill_id" optional="hide"/>
                <field name="model_real" optional="hide"/>
                <field name="reasoning" optional="hide"/>
                <field name="rounds" optional="hide"/>
                <field name="token_input" optional="show" sum="1"/>
                <field name="token_output" optional="show" sum="1"/>
                <field name="token_sys" optional="show" sum="1"/>
                <!-- Kostnad (ai-kostnad-till-likviditet 4.1): faktisk kostnad
                     och debiteringsgrund är TVÅ tal — båda synliga i pivoten,
                     aldrig hopslagna. usage_reported=False syns så omätt inte
                     ser gratis ut. -->
                <field name="cost_usd" optional="show" sum="1"/>
                <field name="usage_reported" optional="hide"/>
                <field name="informative" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_ai_session_line_form" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.form</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <form string="Meddelande">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="agent_id" readonly="1"/>
                            <field name="skill_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="tool_id" readonly="1"/>
                            <field name="model_real" readonly="1"/>
                            <field name="tool_name" readonly="1"/>
                            <field name="token_input" readonly="1"/>
                            <field name="token_output" readonly="1"/>
                            <!-- Per-varv (webui-show-work-again 4.2):
                                 `token_input` är summan över varven — en tur
                                 med åtta verktygsrundor skickar hela
                                 historiken igen varje gång. Utan dessa två
                                 ser 104 437 ut som en enda enorm prompt. -->
                            <field name="rounds" readonly="1"
                                   invisible="not rounds"/>
                            <field name="round_inputs" readonly="1"
                                   invisible="not round_inputs"/>
                            <!-- Tidsmätning per tur (kanalprestanda):
                                 `invisible` när värdet är 0, så en synkron
                                 kanal (0 = ej tillämpligt) inte visar tre
                                 nollor som ser ut som en mätning. -->
                            <field name="first_token_seconds" readonly="1"
                                   invisible="not first_token_seconds"/>
                            <field name="longest_gap_seconds" readonly="1"
                                   invisible="not longest_gap_seconds"/>
                            <field name="stream_seconds" readonly="1"
                                   invisible="not stream_seconds"/>
                        </group>
                        <!-- Tidsmått per tur (kanalprestanda 1.2): 0,000 =
                             ej tillämpligt (kanalen strömmar inte) eller ej
                             mätt. Total väggklocka läses ur create_date-
                             deltat mot föregående rad i sessionen. -->
                        <group string="Timing" name="timing">
                            <field name="first_token_seconds" readonly="1"
                                   digits="[12,3]"/>
                            <field name="longest_gap_seconds" readonly="1"
                                   digits="[12,3]"/>
                            <field name="stream_seconds" readonly="1"
                                   digits="[12,3]"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content" readonly="1"/>
                        </page>
                        <page string="Reasoning" name="reasoning"
                              invisible="not reasoning">
                            <field name="reasoning" readonly="1"/>
                        </page>
                        <page string="Resonemang (debug)" name="debug"
                              invisible="not debug_info">
                            <field name="debug_info" readonly="1"/>
                        </page>
                        <page string="Sources" name="sources"
                              invisible="not source_urls">
                            <field name="source_urls" readonly="1"/>
                        </page>
                        <!-- Verktygsanropet (webui-show-work-again 3.4):
                             `tool_calls` fanns som fält men visades ingenstans,
                             så en tool-rad gick inte att granska i backend —
                             den sade att verktyget kördes men inte med vilka
                             argument. Samma mönster som flikarna ovan:
                             `invisible` när fältet är tomt, så en
                             assistant-rad utan verktyg inte får en tom flik. -->
                        <page string="Verktygsanrop" name="tool_calls"
                              invisible="not tool_calls">
                            <group>
                                <field name="tool_name" readonly="1"/>
                                <field name="tool_call_id" readonly="1"/>
                            </group>
                            <separator string="Argument"/>
                            <field name="tool_calls" readonly="1"/>
                            <separator string="Resultat"/>
                            <field name="content" readonly="1"/>
                        </page>
                        <!-- ── Spåret (session-observability) ────────────────
                             Konversationen säger VAD som sades; de här
                             flikarna säger VAD SOM GJORDES. De läses via
                             related-fält på raden så att detaljerna nås
                             från meddelandet de hör till, utan att gå via
                             sessionen. `invisible` när det inte finns något
                             att visa — en tom flik är brus. -->
                        <page string="Exekvering" name="agent_runs"
                              invisible="not agent_run_ids">
                            <field name="agent_run_ids" readonly="1">
                                <list>
                                    <field name="kind" widget="badge"/>
                                    <field name="agent_id"/>
                                    <field name="model_requested"/>
                                    <field name="model_served"/>
                                    <field name="turn_index"/>
                                    <field name="tokens_in" sum="1"/>
                                    <field name="tokens_out" sum="1"/>
                                    <field name="cost_usd" sum="1"/>
                                    <field name="finish_reason"
                                           widget="badge"/>
                                    <field name="aborted"/>
                                </list>
                            </field>
                        </page>
                        <page string="Verktyg" name="tool_calls_trace"
                              invisible="not tool_call_ids">
                            <field name="tool_call_ids" readonly="1">
                                <list>
                                    <field name="tool_name"/>
                                    <field name="executor"
                                           widget="badge"/>
                                    <field name="tool_call_id"/>
                                    <field name="parent_tool_call_id"
                                           optional="hide"/>
                                    <field name="is_error"/>
                                    <field name="duration_ms" sum="1"/>
                                    <field name="started_at"/>
                                    <field name="result_preview"/>
                                </list>
                            </field>
                        </page>
                        <!-- Gateway-fliken visar sessionens gateway-mått
                             (retries, fallbacks, faktisk kostnad). Fälten
                             nås via `related` på raden, så de är alltid i
                             synk med sessionen.
                             ⚠ `bifrost_cost` är GATEWAYENS kostnad — den
                             slås aldrig ihop med `cost_usd` (faktisk
                             kostnad) eller `token_sys` (debiteringsgrund). -->
                        <page string="Gateway" name="gateway"
                              invisible="not bifrost_synced_at">
                            <group>
                                <field name="gateway_session_id"
                                       readonly="1"/>
                                <field name="bifrost_synced_at"
                                       readonly="1"/>
                            </group>
                            <group>
                                <field name="bifrost_cost" readonly="1"/>
                                <field name="bifrost_retries" readonly="1"/>
                                <field name="bifrost_fallbacks" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search/filter & gruppering för session-line (message) listan:
         Idag / Denna vecka / Denna månad. OBS: webb-säker domän — bara
         context_today() ± datetime.timedelta(days=KONST) (inga .weekday/.replace,
         de kraschar klientens domän-evaluator). "Denna vecka/månad" används som
         rullande fönster (7/30 dagar) för att förbli klient-säker. -->
    <record id="view_ai_session_line_search" model="ir.ui.view">
        <field name="name">ai.coworker.session.line.search</field>
        <field name="model">ai.coworker.session.line</field>
        <field name="arch" type="xml">
            <search string="Meddelanden">
                <field name="content"/>
                <field name="session_id"/>
                <field name="role"/>
                <field name="agent_id"/>
                <field name="tool_id"/>
                <field name="model_real"/>
                <separator/>
                <filter name="today" string="Idag"
                        domain="[('create_date','&gt;=',context_today())]"/>
                <filter name="this_week" string="Denna vecka (7d)"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=7))]"/>
                <filter name="this_month" string="This Month (30d)"
                        domain="[('create_date','&gt;=',context_today()-datetime.timedelta(days=30))]"/>
                <separator/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_date" string="Datum"
                            context="{'group_by':'create_date'}"/>
                    <filter name="group_role" string="Roll"
                            context="{'group_by':'role'}"/>
                    <filter name="group_agent" string="Agent"
                            context="{'group_by':'agent_id'}"/>
                    <filter name="group_model" string="Modell"
                            context="{'group_by':'model_real'}"/>
                    <filter name="group_tool" string="Verktyg"
                            context="{'group_by':'tool_id'}"/>
                    <filter name="group_session" string="Thread"
                            context="{'group_by':'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action definieras sist: den ref:ar view_ai_session_search,
         som måste existera innan actionn laddas (external-ID-ordning). -->
    <record id="action_ai_coworker_session" model="ir.actions.act_window">
        <field name="name">Session</field>
        <field name="res_model">ai.coworker.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_session_search"/>
        <!-- Default: visa bara den inloggade användarens egna sessioner -->
        <field name="context">{'search_default_my_sessions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sessions are registered automatically when AI coworkers converse.
            </p>
        </field>
    </record>

</odoo>
