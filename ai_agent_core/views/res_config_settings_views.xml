<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_agent_core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI API" string="AI API" name="ai_api">
                    <setting id="ai_api_secret_setting">
                        <field name="ai_api_secret" password="True"/>
                        <div class="text-muted">
                            Shared Bearer token for /ai/v1/* and /pi/callback.
                            Falls back to the AI_AGENT_API_SECRET env variable.
                        </div>
                    </setting>
                </app>
                <app data-string="AI Companion" string="AI Companion" name="ai_companion">
                    <setting id="ai_companion_setting">
                        <field name="ai_personal_companion_enabled"/>
                        <div class="text-muted">
                            Creates a personal AI quest for each user.
                        </div>
                    </setting>
                    <setting id="ai_companion_identity_setting"
                             invisible="not ai_personal_companion_enabled">
                        <field name="ai_personal_companion_identity_id"/>
                    </setting>
                </app>
                <app data-string="Odoo Mind" string="Odoo Mind Graph" name="ai_mind_graph">
                    <setting id="ai_graph_sync_batch">
                        <label for="odoomind_sync_batch_size"/>
                        <field name="odoomind_sync_batch_size"/>
                    </setting>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
