<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai_agent_core</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Orkestrering" string="AI Orkestrering"
                     name="ai_agent_core" data-icon="fa-microchip"
                     groups="base.group_system">

                    <!-- ════════════════════════════════════════════
                         Företagsidentitet
                         ════════════════════════════════════════════ -->
                    <block title="Företagsidentitet">

                        <!-- Mission -->
                        <setting id="company_mission_setting">
                            <div class="d-flex align-items-center mb8">
                                <span class="h5 mb0 me-2 fw-bold">Mission</span>
                                <span class="text-muted small">— Företagets existensberättigande</span>
                            </div>
                            <div class="well well-sm mb8 p-2 bg-light rounded">
                                <field name="company_mission" readonly="1"
                                       placeholder="Ingen mission satt ännu..."
                                       class="d-inline"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="object" name="action_open_company"
                                        string="✏️ Redigera" class="oe_link"/>
                                <span class="text-muted small mx-2">|</span>
                                <button type="object" name="action_suggest_mission"
                                        string="💡 Skapa förslag från webben"
                                        class="oe_link"/>
                                <span class="text-muted small ms-3">
                                    Senast: <field name="company_mission_last_review" class="d-inline"/>
                                </span>
                            </div>
                        </setting>

                        <!-- Values -->
                        <setting id="company_values_setting">
                            <div class="d-flex align-items-center mb8">
                                <span class="h5 mb0 me-2 fw-bold">Values</span>
                                <span class="text-muted small">— Företagets kärnvärderingar</span>
                            </div>
                            <div class="well well-sm mb8 p-2 bg-light rounded">
                                <field name="company_values" readonly="1"
                                       placeholder="Inga values satta ännu..."
                                       class="d-inline"/>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="object" name="action_open_company"
                                        string="✏️ Redigera" class="oe_link"/>
                                <span class="text-muted small mx-2">|</span>
                                <button type="object" name="action_suggest_values"
                                        string="💡 Skapa förslag från webben"
                                        class="oe_link"/>
                                <span class="text-muted small ms-3">
                                    Senast: <field name="company_values_last_review" class="d-inline"/>
                                </span>
                            </div>
                        </setting>

                        <!-- Webbplats -->
                        <setting id="company_website_setting"
                                 title="Webbplats för RAG">
                            <div class="d-flex align-items-center gap-2 mb4">
                                <span class="fw-bold me-2">URL:</span>
                                <field name="company_website_url_edit"
                                       placeholder="https://example.com"
                                       class="w-50"/>
                            </div>
                            <div class="text-muted small mb4" invisible="not company_website_rag_last_index">
                                Senaste RAG-index:
                                <field name="company_website_rag_last_index" class="d-inline"/>
                            </div>
                            <div class="mt8">
                                <button type="object" name="action_index_website"
                                        string="🔍 Indexera webbplats" class="btn-primary"/>
                            </div>
                        </setting>
                    </block>

                    <!-- ════════════════════════════════════════════
                         Odoo Mind
                         ════════════════════════════════════════════ -->
                    <block title="Odoo Mind">
                        <setting>
                            <div class="text-muted mb8">
                                Företagets och dess medarbetares andra hjärna
                            </div>
                        </setting>
                        <setting id="odoo_mind_graph_status" title="Graph Status">
                            <div class="d-flex align-items-center gap-3">
                                <span>Noder i grafen:
                                    <field name="graph_node_count" class="d-inline fw-bold"/>
                                </span>
                                <span>Sync batch:
                                    <field name="odoomind_sync_batch_size" class="d-inline"/>
                                </span>
                                <button type="object" name="action_sync_graph_now"
                                        string="Synka nu" icon="fa-refresh"
                                        class="btn-primary"/>
                            </div>
                        </setting>

                        <!-- Company Memory -->
                        <setting id="company_memory_settings" title="Company Memory">
                            <div class="d-flex align-items-center gap-3">
                                <field name="company_memory_auto_extract"/>
                                <label for="company_memory_auto_extract" string="Auto-extraction"/>
                                <span>Konsolidering varje</span>
                                <field name="company_memory_consolidation_days" class="d-inline"/>
                                <span>dag(ar)</span>
                            </div>
                        </setting>

                        <!-- Personal Memory -->
                        <setting id="personal_memory_settings" title="Personal Memory">
                            <div class="d-flex align-items-center gap-3">
                                <field name="personal_memory_learning_enabled"/>
                                <label for="personal_memory_learning_enabled" string="Lär från Discuss"/>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <field name="personal_memory_auto_nudge"/>
                                <label for="personal_memory_auto_nudge" string="Auto-nudge"/>
                                <span>varje</span>
                                <field name="personal_memory_nudge_interval" class="d-inline"/>
                                <span>dag(ar)</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <span>Konsolidering varje</span>
                                <field name="personal_memory_consolidation_hours" class="d-inline"/>
                                <span>timme/-ar</span>
                            </div>
                        </setting>

                        <!-- AI Coworker Memory -->
                        <setting id="coworker_memory_settings" title="AI Coworker Memory">
                            <div class="d-flex align-items-center gap-3">
                                <field name="coworker_memory_retention"/>
                                <label for="coworker_memory_retention" string="Sessionsminne"/>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <span>Spara max</span>
                                <field name="coworker_memory_retention_limit" class="d-inline"/>
                                <span>sessioner</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <span>Glöm efter</span>
                                <field name="coworker_memory_forget_days" class="d-inline"/>
                                <span>dag(ar)</span>
                            </div>
                        </setting>

                        <setting id="okf_budget_settings" title="Embedding-budget (OKF)"
                                 help="Kostnaden belastar den coworker som utför indexeringen (session_line_count/started_mtokens).">
                            <div class="d-flex align-items-center gap-3">
                                <label for="company_memory_coworker_id" string="Company-minne indexeras av"/>
                                <field name="company_memory_coworker_id"/>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <label for="personal_memory_coworker_id" string="Personligt minne indexeras av"/>
                                <field name="personal_memory_coworker_id"/>
                            </div>
                        </setting>

                        <setting id="okf_dept_health_settings" title="Avdelningshälsa-trösklar (OKF)"
                                 help="Gränsvärdena för röd/gul/grön avdelningshälsa — inte hårdkodade.">
                            <div class="d-flex align-items-center gap-3">
                                <label for="health_heartbeat_stale_days" string="Heartbeat stale efter"/>
                                <field name="health_heartbeat_stale_days" class="d-inline"/>
                                <span>dagar</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <label for="health_active_ratio" string="Grön kräver ≥"/>
                                <field name="health_active_ratio" class="d-inline"/>
                                <span>% heartbeatar</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <label for="health_no_session_days" string="Gul/röd utan session efter"/>
                                <field name="health_no_session_days" class="d-inline"/>
                                <span>dagar</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <label for="health_zero_tokens_days" string="Röd vid 0 tokens efter"/>
                                <field name="health_zero_tokens_days" class="d-inline"/>
                                <span>dagar</span>
                            </div>
                        </setting>

                        <setting id="okf_catalog_settings" title="OKF-katalog (artefakttyper, resolvers, koncept)"
                                 help="Status för det registrerbara artefakt-lagret — öppna listorna för att hantera.">
                            <div class="d-flex align-items-center gap-3">
                                <field name="okf_artifact_type_count" class="d-inline"/>
                                <span>artefakttyper</span>
                                <button name="action_open_artifact_types" type="object"
                                        string="Hantera" icon="fa-external-link" class="btn-link"/>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <field name="okf_resolver_count" class="d-inline"/>
                                <span>aktiva access-resolvers</span>
                                <button name="action_open_access_resolvers" type="object"
                                        string="Hantera" icon="fa-external-link" class="btn-link"/>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt4">
                                <field name="okf_concept_count" class="d-inline"/>
                                <span>koncept (ej arkiverade)</span>
                                <button name="action_open_okf_concepts" type="object"
                                        string="Visa" icon="fa-external-link" class="btn-link"/>
                            </div>
                        </setting>
                    </block>

                    <!-- ════════════════════════════════════════════
                         AI API
                         ════════════════════════════════════════════ -->
                    <block title="AI API">
                        <setting id="ai_api_secret_setting" title="API Secret">
                            <field name="ai_api_secret" placeholder="Shared Bearer token"/>
                            <div class="text-muted">
                                Delas mellan /ai/v1/*, /pi/callback och externa system.
                                Fallback till miljövariabeln AI_AGENT_API_SECRET.
                            </div>
                        </setting>
                        <setting id="ai_api_default_provider" title="Default Provider">
                            <field name="ai_api_default_provider_id"/>
                        </setting>
                        <setting id="ai_api_default_model" title="Default Model">
                            <field name="ai_api_default_model_id"/>
                        </setting>
                    </block>

                    <!-- ════════════════════════════════════════════
                         Tool Executor (NATS)
                         ════════════════════════════════════════════ -->
                    <block title="Tool Executor (NATS)">
                        <setting id="nats_retries" title="Max Retries">
                            <field name="pi_nats_max_retries"/>
                        </setting>
                        <setting id="nats_restarts" title="Max Restarts">
                            <field name="pi_nats_max_restarts"/>
                        </setting>
                        <setting id="nats_restart_window" title="Restart Window (minutes)">
                            <field name="pi_nats_restart_window"/>
                        </setting>
                    </block>

                    <!-- ════════════════════════════════════════════
                         AI Agents
                         ════════════════════════════════════════════ -->
                    <block title="AI Agents">
                        <setting id="agent_max_rounds" title="Max Loop Turns">
                            <field name="ai_agent_max_rounds"/>
                        </setting>
                        <setting id="agent_tool_timeout" title="Tool Timeout (s)">
                            <field name="ai_agent_tool_timeout"/>
                        </setting>
                        <setting id="agent_default_identity" title="Default Identity">
                            <field name="ai_agent_default_identity_id"/>
                        </setting>
                    </block>

                    <!-- ════════════════════════════════════════════
                         Background Jobs
                         ════════════════════════════════════════════ -->
                    <!-- ════════════════════════════════ Heartbeat Settings ════════════════════════════════ -->
                    <block title="Heartbeat">
                        <setting id="heartbeat_enabled" help="Slå på/av heartbeat för alla coworkers">
                            <field name="heartbeat_enabled"/>
                        </setting>
                        <setting id="heartbeat_interval" help="Hur ofta coworkers vaknar och kollar läget">
                            <field name="heartbeat_interval"/>
                        </setting>
                    </block>

                    <block title="Background Jobs">
                        <setting id="bg_jobs_display" string="Konfigurera indexerare">
                            <field name="bg_cron_line_ids" widget="one2many">
                                <form>
                                    <group>
                                        <field name="cron_id" readonly="1" force_save="1"/>
                                        <field name="cron_name" readonly="1"/>
                                        <field name="cron_active"/>
                                        <field name="cron_interval_number"/>
                                        <field name="cron_interval_type"/>
                                        <field name="cron_lastcall" readonly="1"/>
                                        <field name="cron_failure_count" readonly="1"/>
                                        <field name="cron_code" readonly="1"/>
                                        <button name="action_run_now" type="object"
                                                string="Kör nu" icon="fa-play"/>
                                    </group>
                                </form>
                                <list>
                                    <field name="cron_name"/>
                                    <field name="cron_active"/>
                                    <field name="cron_interval_number"/>
                                    <field name="cron_interval_type"/>
                                    <field name="cron_lastcall"/>
                                    <field name="cron_failure_count"/>
                                </list>
                            </field>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
