<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit hr.department form — add AI manager -->
    <record id="hr_view_department_form_inherit_ai" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.ai</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_ai_goals" type="object"
                        class="oe_stat_button" icon="fa-bullseye"
                        groups="ai_agent_core.group_ai_officer">
                    <field name="ai_goal_count" widget="statinfo"/>
                    <span class="o_stat_text">🎯 Mål</span>
                </button>
                <button name="action_open_ai_tasks" type="object"
                        class="oe_stat_button" icon="fa-tasks"
                        groups="ai_agent_core.group_ai_officer">
                    <field name="ai_task_count" widget="statinfo"/>
                    <span class="o_stat_text">📋 Tasks</span>
                </button>
                <button name="action_open_ai_hitl" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        groups="ai_agent_core.group_ai_officer">
                    <field name="hitl_open_count" widget="statinfo"/>
                    <span class="o_stat_text">🛡️ HITL</span>
                </button>
            </div>
            <field name="manager_id" position="after">
                <field name="ai_manager_id" placeholder="Välj AI-chef..."
                    options="{'no_create': True}"/>
            </field>
            <field name="name" position="after">
                <field name="health" widget="badge"
                       decoration-success="health == 'green'"
                       decoration-warning="health == 'yellow'"
                       decoration-danger="health == 'red'"/>
            </field>
            <!-- Avdelningens bild (department-kanban-visual 1.2). Standard
                 Odoo-mönstret: oe_avatar före oe_title, så bilden hamnar
                 uppe till höger i formuläret och är klickbar för uppladdning. -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="image" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//field[@name='manager_id']/.." position="after">
                <group string="Odoo Mind-kontext">
                    <field name="artifact_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           help="Avdelningens intressen — coworkerns company-scope-injektion filtreras på dessa."/>
                    <field name="health_reason" readonly="1"/>
                </group>
            </xpath>
            <!-- Medlemsöversikt (org-goal-integrity D9): två ansiktslistor
                 sida vid sida — AI-medarbetare och mänskliga. Båda visar
                 högst 10 poster (9 ansikten + "+N"). -->
            <xpath expr="//field[@name='manager_id']/.." position="after">
                <group string="Medlemmar" groups="ai_agent_core.group_ai_officer">
                    <field name="ai_coworker_ids" widget="many2many_tags_avatar"
                           options="{'visibleItemsLimit': 10}"
                           help="AI-medarbetare i avdelningen."/>
                    <field name="employee_ids" widget="many2many_tags_avatar"
                           options="{'visibleItemsLimit': 10}"
                           help="Mänskliga medarbetare i avdelningen."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Inherit hr.department tree — add AI staff count + health -->
    <record id="hr_view_department_tree_inherit_ai" model="ir.ui.view">
        <field name="name">hr.department.tree.inherit.ai</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_tree"/>
        <field name="arch" type="xml">
            <field name="manager_id" position="after">
                <field name="health" widget="badge"
                       decoration-success="health == 'green'"
                       decoration-warning="health == 'yellow'"
                       decoration-danger="health == 'red'"/>
                <field name="total_ai_staff" string="🤖 AI-staff"/>
            </field>
        </field>
    </record>
    <!-- Inherit hr.department kanban — AI info + onboarding (change ai-orchestration-tidy-up, a+b) -->
    <!-- En källa till sanning: HR:s standardkanban ärvas, AI-dashboarden pekar om till samma vy -->
    <record id="hr_department_kanban_inherit_ai" model="ir.ui.view">
        <field name="name">hr.department.kanban.inherit.ai</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.hr_department_view_kanban"/>
        <field name="arch" type="xml">
            <!-- Fält som kanban-korten behöver läsa -->
            <field name="active" position="after">
                <field name="image"/>
                <field name="write_date"/>
                <field name="ai_manager_id"/>
                <field name="total_ai_staff"/>
                <field name="ai_heartbeat_count"/>
                <field name="ai_goal_count"/>
                <field name="health"/>
                <field name="ai_coworker_ids"/>
            </field>

            <!-- Kort-header enligt timesheets-mönstret (department-kanban-visual
                 2.2, D2 + putsning 2026-10-16).

                 STRUKTUR: en flex-rad [bild | (namn + chef)]. Core lägger
                 namn-länken och manager-fältet som SYSKON, så enbart
                 `float-start` på bilden ger inte rätt ordning — texten hamnar
                 under bilden i stället för bredvid. Vi döljer därför core:s
                 manager-nod och ritar om hela headern i en egen flex-container
                 där vi äger ordningen.

                 Rå <img> mot /web/image — image-widgeten är interaktiv
                 (klickbar för uppladdning) och fel i ett kanban-kort. ?unique=
                 mot write_date ger cache-busting så ett bildbyte syns direkt.

                 OBS: fältnamnet är `image`, INTE `image_128`. fields.Image
                 med attachment=True genererar inga image_128/256-varianter
                 (column_type=None, värdet ligger i ir.attachment), så
                 /web/image/.../image_128 faller tillbaka på platshållaren.
                 Storleken styrs i stället med width/height-parametrar.

                 VÄLJARE: `//a[@type='open']` är TVETYDIG — core-kanbanen har
                 två sådana (kugghjulsmenyns "Configuration" och kortets namn).
                 Vi ankrar därför på namn-fältet, som bara finns i kortet. -->
            <xpath expr="//a[@type='open']/field[@name='name']" position="before">
                <img t-att-src="'/web/image/hr.department/' + record.id.raw_value + '/image'
                                + '?width=128&amp;height=128'
                                + '&amp;unique=' + record.write_date.raw_value"
                     class="o_image_64_cover flex-shrink-0 me-2"
                     alt="Avdelningens bild"/>
            </xpath>

            <!-- Core:s manager-rad döljs: vi ritar den själva under namnet. -->
            <field name="manager_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- Namnet: större än timesheets-referensen (fs-4, inte fs-5) —
                 avdelningens namn är kortets huvudinformation och ska bära
                 vikten. `d-block` + `text-truncate` håller en rad. -->
            <xpath expr="//a[@type='open']/field[@name='name']" position="attributes">
                <attribute name="class">fw-bold fs-4 d-block text-truncate</attribute>
            </xpath>

            <!-- Chef + hälsa UNDER namnet (putsat 2026-10-16). Core:s
                 manager-rad är dold ovan; här ritas den i en egen rad under
                 namn-länken, i samma flex-kolumn som namnet så att den linjerar
                 med namnet och inte med bilden.

                 VÄLJARE: ankra på namn-FÄLTET, inte på `<a type="open">` —
                 samma tvetydighet som bilden råkade ut för (kugghjulsmenyn har
                 också en `<a type="open">`). `..` går upp till namn-länken. -->
            <xpath expr="//a[@type='open']/field[@name='name']/.." position="after">
                <div class="d-flex flex-wrap align-items-center gap-1 mt-1"
                     groups="ai_agent_core.group_ai_officer">
                    <t t-if="record.ai_manager_id.raw_value">
                        <span class="badge bg-info">🤖 <field name="ai_manager_id"/></span>
                    </t>
                    <t t-if="!record.ai_manager_id.raw_value and record.manager_id.raw_value">
                        <span class="badge bg-secondary">👤 <field name="manager_id"/></span>
                    </t>
                    <field name="health" widget="badge"
                           decoration-success="health == 'green'"
                           decoration-warning="health == 'yellow'"
                           decoration-danger="health == 'red'"/>
                </div>
            </xpath>

            <!-- AI-staff-knapp (kanban_primary_right) — sida vid sida med
                 core-kortets total_employee-knapp (department-kanban-visual
                 D3). Kort etikett + text-nowrap: "AI-medarbetare" är långt
                 och col-6 är smal, så etiketten kapas till "AI". -->
            <div name="kanban_primary_right" position="inside">
                <button class="btn btn-outline-primary w-100 text-nowrap"
                        name="action_get_ai_staff" type="object"
                        groups="ai_agent_core.group_ai_officer">
                    🤖 <field name="total_ai_staff"/> AI
                </button>
            </div>

            <!-- Kompakt AI-sammanfattning (department-kanban-visual D4):
                 ersätter ett sub-kort per coworker. Aggregerade siffror i en
                 enda rad — detaljlistan nås via action_get_ai_staff-knappen
                 ovan. Detta håller korten jämnhöga oavsett antal AI-
                 medarbetare (spec: "Kortet håller jämn höjd"). -->
            <div name="kanban_card_lower_content" position="inside">
                <div class="mt-2" groups="ai_agent_core.group_ai_officer">
                    <div class="d-flex flex-wrap gap-2 small text-muted">
                        <span title="AI-medarbetare med heartbeat aktiverad">
                            💓 <field name="ai_heartbeat_count"/> aktiva
                        </span>
                        <span title="OKR-mål för avdelningen">
                            🎯 <field name="ai_goal_count"/> mål
                        </span>
                    </div>

                    <!-- Snabbliänkar: Tasks + OKR för avdelningen (som Time Off requests på hr.employee) -->
                    <div class="mt-2 d-flex flex-wrap gap-2" groups="ai_agent_core.group_ai_officer">
                        <button class="btn btn-sm btn-outline-secondary"
                                type="object" name="action_open_ai_tasks">📋 Tasks</button>
                        <button class="btn btn-sm btn-outline-secondary"
                                type="object" name="action_open_ai_goals">🎯 OKR</button>
                    </div>
                </div>
            </div>

            <!-- Onboarding i kugghjulsmenyn -->
            <xpath expr="//div[hasclass('o_kanban_card_manage_settings')]" position="after">
                <div class="row" groups="ai_agent_core.group_ai_officer">
                    <div class="col-12">
                        <h5 role="menuitem" class="o_kanban_card_manage_title">
                            <span>AI-organisation</span>
                        </h5>
                        <a role="menuitem" type="action"
                           name="ir_action_server_start_onboarding"
                           class="dropdown-item">🚀 Starta onboarding</a>
                        <a role="menuitem" type="action"
                           name="ir_action_server_restart_onboarding"
                           class="dropdown-item">🔄 Starta om</a>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- AI-specifik hierarchy-vy för hr.department (lånar utseende från
         hr_org_chart.hr_department_hierarchy_view + visar AI-info). -->
    <record id="hr_department_hierarchy_view_ai" model="ir.ui.view">
        <field name="name">hr.department.view.hierarchy.ai</field>
        <field name="model">hr.department</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" draggable="1">
                <field name="name"/>
                <field name="color"/>
                <field name="health"/>
                <field name="ai_manager_id"/>
                <field name="total_ai_staff"/>
                <field name="ai_task_count"/>
                <field name="ai_goal_count"/>
                <field name="fold" foldable="1"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div t-attf-class="o_hierarchy_node_header d-flex justify-content-center align-items-center o_hierarchy_node_color_{{ record.color.raw_value }}">
                            <field name="name"/>
                        </div>
                        <div class="o_hierarchy_node_body d-flex flex-column">
                            <field name="manager_id" class="pt-1 ps-1" widget="many2one_avatar_employee"/>
                            <t t-if="record.ai_manager_id.raw_value">
                                <span class="badge bg-info mt-1 ms-1">🤖 <field name="ai_manager_id"/></span>
                            </t>
                            <div class="d-flex align-items-center gap-2 mt-1 ms-1">
                                <span class="badge bg-warning text-dark">🤖 <field name="total_ai_staff"/> AI</span>
                                <field name="health" widget="badge"
                                       decoration-success="health == 'green'"
                                       decoration-warning="health == 'yellow'"
                                       decoration-danger="health == 'red'"/>
                            </div>
                            <div class="d-flex gap-2 mt-1 ms-1">
                                <span class="badge bg-secondary text-light"
                                      title="Antal AI-tasks i avdelningen">📋 <field name="ai_task_count"/></span>
                                <span class="badge bg-secondary text-light"
                                      title="Antal OKR-mål i avdelningen">🎯 <field name="ai_goal_count"/></span>
                            </div>
                            <div class="d-flex gap-2 mt-1 ms-1" groups="ai_agent_core.group_ai_officer">
                                <button class="btn btn-link p-0" type="object" name="action_open_ai_tasks">📋 Tasks</button>
                                <button class="btn btn-link p-0" type="object" name="action_open_ai_goals">🎯 OKR</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>
</odoo>
