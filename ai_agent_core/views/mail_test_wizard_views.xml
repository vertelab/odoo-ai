<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_coworker_mail_test_wizard_form" model="ir.ui.view">
        <field name="name">ai.coworker.mail.test.wizard.form</field>
        <field name="model">ai.coworker.mail.test.wizard</field>
        <field name="arch" type="xml">
            <form string="Testa mail-flödet">
                <header>
                    <button name="action_run" string="Testa mail-flödet"
                            type="object" class="btn-primary"
                            invisible="state != 'input'"/>
                    <button name="action_close" string="Stäng"
                            type="object" invisible="state != 'done'"/>
                </header>
                <sheet>
                    <group invisible="state != 'input'">
                        <group string="Mail-test">
                            <field name="coworker_id"
                                   options="{'no_create': True}"/>
                            <field name="eml_file" filename="eml_filename"
                                   widget="binary"
                                   help="Ladda upp en .eml-fil (mail) som startar mail-testflödet. Bilagor i filen läggs som bilagor + minnen på sessionen."/>
                            <field name="eml_filename" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state != 'done'">
                        <group string="Resultat">
                            <field name="result" readonly="1" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_coworker_mail_test_wizard_action" model="ir.actions.act_window">
        <field name="name">Testa mail-flödet</field>
        <field name="res_model">ai.coworker.mail.test.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
