<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- AI Orchestration Dashboard — hr.department kanban (ärvd standardvy)

         Sedan change ai-orchestration-tidy-up använder dashboarden samma
         ärvda vy som HR (hr.hr_department_view_kanban + inherit
         hr_department_kanban_inherit_ai i hr_department_views.xml).
         Den egna custom-kanbanen (view_ai_orchestration_dashboard) är borttagen
         — en källa till sanning. -->

    <!-- Dashboard action -->
    <record id="action_ai_orchestration_dashboard" model="ir.actions.act_window">
        <field name="name">AI Orkestrering</field>
        <field name="res_model">hr.department</field>
        <field name="view_mode">kanban,list,hierarchy,form</field>
        <field name="help" type="html">
            <p><strong>AI Orchestration Dashboard</strong></p>
            <p>Här ser du hela din AI-organisation — avdelningar, AI-medarbetare, status och hälsa.</p>
            <p>💡 Kugghjulet på varje kort: "🚀 Starta onboarding" bygger organisationen, "🔄 Starta om" kör om intervjun.</p>
        </field>
    </record>

    <record id="ai_orchestration_dashboard_hierarchy_view" model="ir.actions.act_window.view">
        <field name="sequence" eval="12"/>
        <field name="view_mode">hierarchy</field>
        <field name="act_window_id" ref="action_ai_orchestration_dashboard"/>
        <field name="view_id" ref="hr_department_hierarchy_view_ai"/>
    </record>

    <!-- Onboarding server action button -->
    <record id="ir_action_server_start_onboarding" model="ir.actions.server">
        <field name="name">🚀 Starta AI Onboarding</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
action = env['ai.onboarding'].create({
    'ceo_user_id': env.user.id,
}).action_start_interview()
        </field>
    </record>

    <!-- Restart onboarding server action -->
    <record id="ir_action_server_restart_onboarding" model="ir.actions.server">
        <field name="name">🔄 Starta om onboarding</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
onboarding = env['ai.onboarding'].search([
    ('ceo_user_id', '=', env.user.id),
    ('state', 'in', ('completed', 'cancelled')),
], order='create_date desc', limit=1)
if onboarding:
    onboarding.action_restart()
    action = onboarding.action_start_interview()
else:
    action = env['ai.onboarding'].create({
        'ceo_user_id': env.user.id,
    }).action_start_interview()
        </field>
    </record>
</odoo>
