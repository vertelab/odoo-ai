<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_onboarding_form" model="ir.ui.view">
        <field name="name">ai.onboarding.form</field>
        <field name="model">ai.onboarding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_interview" type="object"
                        string="🚀 Starta onboarding-intervju"
                        class="btn-primary"
                        />
                    <button name="action_restart" type="object"
                        string="🔄 Starta om"
                        class="btn-secondary"/>
                    <button name="action_cancel" type="object"
                        string="Avbryt" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="ceo_user_id" options="{'no_create': True}"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="coworker_id" options="{'no_create': True}"/>
                            <field name="interview_session_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detected Modules">
                            <field name="detected_modules" readonly="1"/>
                            <field name="website_summary" readonly="1"/>
                        </page>
                        <page string="Interview Answers">
                            <field name="answers" readonly="1"/>
                        </page>
                        <page string="Proposal">
                            <field name="proposal_json" readonly="1"/>
                            <field name="adjustments"/>
                        </page>
                        <page string="Created Resources">
                            <group>
                                <field name="created_department_ids" readonly="1"
                                    options="{'no_create': True}"/>
                                <field name="created_coworker_ids" readonly="1"
                                    options="{'no_create': True}"/>
                                <field name="created_goal_ids" readonly="1"
                                    options="{'no_create': True}"/>
                                <field name="created_employee_ids" readonly="1"
                                    options="{'no_create': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_onboarding" model="ir.actions.act_window">
        <field name="name">Onboarding</field>
        <field name="res_model">ai.onboarding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_ceo_user_id': uid}</field>
    </record>
</odoo>
