<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Tree view -->
        <record id="view_ai_personal_memory_tree" model="ir.ui.view">
            <field name="name">ai.personal.memory.tree</field>
            <field name="model">ai.personal.memory</field>
            <field name="arch" type="xml">
                <list default_order="create_date desc">
                    <field name="content_preview" string="Memory"/>
                    <field name="category"/>
                    <field name="importance"/>
                    <field name="source"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_ai_personal_memory_form" model="ir.ui.view">
            <field name="name">ai.personal.memory.form</field>
            <field name="model">ai.personal.memory</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id"/>
                                <field name="category"/>
                                <field name="importance"/>
                            </group>
                            <group>
                                <field name="source"/>
                                <field name="source_ref"/>
                                <field name="create_date"/>
                                <field name="access_count"/>
                            </group>
                        </group>
                        <group>
                            <field name="content" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_ai_personal_memory_search" model="ir.ui.view">
            <field name="name">ai.personal.memory.search</field>
            <field name="model">ai.personal.memory</field>
            <field name="arch" type="xml">
                <search>
                    <field name="content"/>
                    <field name="category"/>
                    <field name="source"/>
                    <field name="importance"/>
                    <field name="user_id"/>
                    <separator/>
                    <filter name="archived" string="Archived"
                            domain="[('archived', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_category" string="Category"
                                context="{'group_by': 'category'}"/>
                        <filter name="group_source" string="Source"
                                context="{'group_by': 'source'}"/>
                        <filter name="group_importance" string="Importance"
                                context="{'group_by': 'importance'}"/>
                        <filter name="group_date" string="Created"
                                context="{'group_by': 'create_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ai_personal_memory" model="ir.actions.act_window">
            <field name="name">Personal Memories</field>
            <field name="res_model">ai.personal.memory</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No personal memories yet.
                </p>
                <p>
                    Personal memories are created automatically when you
                    interact with AI quests. They store facts, preferences,
                    and context that follow you across all quests.
                </p>
            </field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_ai_personal_memory"
                  name="Personal Memories"
                  parent="menu_ai_technical_root" sequence="30"
                  action="action_ai_personal_memory"
                  sequence="90"/>

    </data>
</odoo>
