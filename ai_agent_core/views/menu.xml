<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Actions (must be before menus) ===== -->
    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">ai.model</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_provider': 1}</field>
    </record>
    <record id="action_ai_settings" model="ir.actions.act_window">
        <field name="name">Inställningar</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module':'ai_agent_core'}</field>
    </record>
    <record id="action_ai_coworker" model="ir.actions.act_window">
        <field name="name">AI medarbetare</field>
        <field name="res_model">ai.coworker</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_agent" model="ir.actions.act_window">
        <field name="name">Agenter</field>
        <field name="res_model">ai.agent</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_identity" model="ir.actions.act_window">
        <field name="name">Identiteter</field>
        <field name="res_model">ai.identity</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">ai.skill</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_memory" model="ir.actions.act_window">
        <field name="name">Memory</field>
        <field name="res_model">ai.memory</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ai_chat" model="ir.actions.act_url">
        <field name="name">AI Chat</field>
        <field name="url">/ai/chat</field>
        <field name="target">self</field>
    </record>

    <!-- ===== New Org Actions ===== -->
    <record id="action_ai_org_goal" model="ir.actions.act_window">
        <field name="name">Goals (OKR)</field>
        <field name="res_model">ai.org.goal</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
    <record id="action_ai_org_task" model="ir.actions.act_window">
        <field name="name">AI Tasks</field>
        <field name="res_model">ai.org.task</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ai_org_review" model="ir.actions.act_window">
        <field name="name">AI Performance Reviews</field>
        <field name="res_model">ai.org.review</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ai_org_board" model="ir.actions.act_window">
        <field name="name">AI Board</field>
        <field name="res_model">ai.org.board</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ai_onboarding" model="ir.actions.act_window">
        <field name="name">Onboarding</field>
        <field name="res_model">ai.onboarding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_ceo_user_id': uid}</field>
    </record>

    <!-- ===== Root menu ===== -->
    <menuitem id="menu_ai_root" name="AI Orkestrering"
              sequence="90" groups="ai_agent_core.group_ai_officer"/>

    <!-- Teknisk uppsättning under Settings → Technical (admin).
         Deklareras här (före Organisation/Configuration) eftersom XML
         laddas sekventiellt — parent måste finnas före barn. -->
    <menuitem id="menu_ai_technical_root" name="AI Orkestrering"
              parent="base.menu_custom" sequence="90"
              groups="ai_agent_core.group_ai_admin"/>

    <!-- Technical-Organisation: Review + Onboarding (övriga ligger i rot-Organisation) -->
    <menuitem id="menu_ai_technical_org" name="Organisation"
              parent="menu_ai_technical_root" sequence="10"
              groups="ai_agent_core.group_ai_admin"/>

    <!-- Technical-Configuration: tekniska AI-menyer (Personal/Company Memory,
         Graph, Uploads, Access Resolvers, Personal Goals) -->
    <menuitem id="menu_ai_technical_config" name="Configuration"
              parent="menu_ai_technical_root" sequence="20"
              groups="ai_agent_core.group_ai_admin"/>

    <!-- Dashboard ligger direkt under root (Organisation flyttas till Technical) -->
    <menuitem id="menu_ai_orchestration_dashboard" name="Dashboard"
              parent="menu_ai_organization" sequence="5"
              action="action_ai_orchestration_dashboard"/>

    <!-- Coworkers & Agents (officer + admin) -->
    <menuitem id="menu_ai_coworker" name="AI medarbetare" parent="menu_ai_root"
              sequence="10" action="action_ai_coworker"/>
    <menuitem id="menu_ai_agent" name="Agenter" parent="menu_ai_root"
              sequence="20" action="action_ai_agent"/>

    <!-- AI Chat — ligger i användarmenyn (längst upp till höger, bredvid
         Documentation/Support/Preferences) via JS-registrering i
         static/src/js/user_menu_ai_chat.js (Odoo 18 user_menuitems).
         Alla användare har ai.group_user implicit via base.group_user. -->

    <!-- Organization submenu — i rotmenyn. Dashboard/Mål/Tasks/Board här;
         Reviews + Onboarding ligger under Technical → AI Orkestrering →
         Organisation (menu_ai_technical_org). -->
    <menuitem id="menu_ai_organization" name="Organisation"
              parent="menu_ai_root" sequence="5"/>
    <menuitem id="menu_ai_org_goal" name="Mål (OKR)" parent="menu_ai_organization"
              sequence="10" action="action_ai_org_goal"/>
    <menuitem id="menu_ai_org_task" name="Tasks" parent="menu_ai_organization"
              sequence="20" action="action_ai_org_task"/>
    <menuitem id="menu_ai_org_review" name="Reviews" parent="menu_ai_technical_org"
              sequence="30" action="action_ai_org_review"/>
    <menuitem id="menu_ai_org_board" name="Board" parent="menu_ai_organization"
              sequence="40" action="action_ai_org_board"/>
    <menuitem id="menu_ai_onboarding" name="Onboarding" parent="menu_ai_technical_org"
              sequence="50" action="action_ai_onboarding"/>

    <!-- Configuration submenu (endast ai.group_admin) — i rotmenyn -->
    <menuitem id="menu_ai_configuration" name="Configuration"
              parent="menu_ai_root" sequence="99"
              groups="ai_agent_core.group_ai_admin"/>

    <menuitem id="menu_ai_settings" name="Inställningar" parent="menu_ai_configuration"
              sequence="1" action="action_ai_settings"/>
    <menuitem id="menu_ai_identity" name="Identiteter" parent="menu_ai_configuration"
              sequence="5" action="action_ai_identity"/>
    <menuitem id="menu_ai_provider" name="Providers" parent="menu_ai_configuration"
              sequence="10" action="action_ai_provider"/>
    <menuitem id="menu_ai_model" name="Models" parent="menu_ai_configuration"
              sequence="15" action="action_ai_model"/>
    <menuitem id="menu_ai_skill_menu" name="Skills" parent="menu_ai_configuration"
              sequence="20" action="action_ai_skill"/>
    <menuitem id="menu_ai_memory" name="Memory" parent="menu_ai_configuration"
              sequence="30" action="action_ai_memory"/>
    <menuitem id="menu_ai_okf_concepts" name="OKF Concepts"
              parent="menu_ai_configuration" sequence="40"
              action="action_ai_okf_concept"/>
    <menuitem id="menu_ai_okf_dashboard" name="Odoo Mind Dashboard"
              parent="menu_ai_configuration" sequence="55"
              action="action_ai_okf_dashboard"/>

    <!-- Monthly Summary -->
    <menuitem id="menu_ai_monthly_summary" name="Monthly Summary"
              parent="menu_ai_configuration" sequence="60"
              action="ai_monthly_summary_action"/>

    <!-- ===== Settings → Technical → AI Orkestrering ===== -->
    <!-- Teknisk uppsättning: avancerade AI-menyer under Settings → Technical
         (endast ai.group_admin). De operativa menyerna (Dashboard, AI
         medarbetare, Agenter) ligger kvar i rotmenyn AI Orkestrering. -->

    <!-- Inställningar finns i rotmenyns Configuration — ingen teknisk kopia. -->

    <!-- Personal Memories / Company Memory / Odoo Mind Graph definieras i
         respektive views-fil (ai_personal_memory_views.xml,
         ai_company_memory_views.xml, ai_graph_node_views.xml) med parent
         menu_ai_technical_root — inga dubbletter här. -->

    <!-- Personal Goals (alla) -->
    <menuitem id="menu_ai_personal_goals_tech" name="Personal Goals"
              parent="menu_ai_technical_config" sequence="10"
              groups="ai_agent_core.group_ai_admin"
              action="action_ai_personal_goal"/>

    <!-- Uppladdningar (OKF) -->
    <menuitem id="menu_ai_okf_uploads" name="Uppladdningar (OKF)"
              parent="menu_ai_technical_config" sequence="30"
              groups="ai_agent_core.group_ai_admin"
              action="action_ai_okf_upload"/>

    <!-- Access Resolvers -->
    <menuitem id="menu_ai_access_resolvers" name="Access Resolvers"
              parent="menu_ai_technical_config" sequence="40"
              groups="ai_agent_core.group_ai_admin"
              action="action_ai_access_resolver"/>
</odoo>
