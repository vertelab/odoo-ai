<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_org_board_tree" model="ir.ui.view">
        <field name="name">ai.org.board.tree</field>
        <field name="model">ai.org.board</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="decision_count"/>
            </list>
        </field>
    </record>

    <record id="view_ai_org_board_form" model="ir.ui.view">
        <field name="name">ai.org.board.form</field>
        <field name="model">ai.org.board</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="AI Board Members">
                            <field name="member_ids" options="{'no_create': True}"/>
                        </page>
                        <page string="Human Board Members">
                            <field name="human_member_ids" options="{'no_create': True}"/>
                        </page>
                        <page string="Decisions">
                            <field name="decision_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="status" widget="badge"/>
                                    <field name="proposed_by"/>
                                    <field name="votes_for"/>
                                    <field name="votes_against"/>
                                    <field name="create_date"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="title"/>
                                        <field name="status" widget="badge"/>
                                        <field name="proposed_by"/>
                                    </group>
                                    <field name="description"/>
                                    <group>
                                        <field name="votes_for"/>
                                        <field name="votes_against"/>
                                        <field name="votes_abstain"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_org_board" model="ir.actions.act_window">
        <field name="name">AI Board</field>
        <field name="res_model">ai.org.board</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
