<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban with image + color -->
    <record id="view_ai_skill_kanban" model="ir.ui.view">
        <field name="name">ai.skill.kanban</field>
        <field name="model">ai.skill</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" color_field="color"
                    quick_create="false" highlight_color="color">
                <field name="color"/>
                <field name="image_128"/>
                <field name="category"/>
                <field name="compatibility"/>
                <field name="use_count"/>
                <field name="version"/>
                <field name="source_type"/>
                <field name="agent_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <aside class="col-2 me-1">
                                <field name="image_128" widget="image"
                                       t-att-alt="record.name.value"/>
                            </aside>
                            <main class="ms-2">
                                <div class="o_text_overflow d-flex align-items-center">
                                    <strong class="fs-5"><field name="name"/></strong>
                                </div>
                                <div class="text-muted small mt-1">
                                    <field name="description"/>
                                </div>
                                <footer>
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                        <div>
                                            <span class="badge bg-secondary">
                                                <field name="category"/>
                                            </span>
                                            <span class="badge bg-info ms-1"
                                                  t-if="record.source_type.raw_value == 'github'">
                                                <span class="fa fa-github"/> GitHub
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <span class="text-muted small me-2">
                                                <field name="agent_count"/> agents
                                            </span>
                                            <span class="text-muted small">
                                                v<field name="version"/>
                                            </span>
                                        </div>
                                    </div>
                                </footer>
                            </main>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List -->
    <record id="view_ai_skill_tree" model="ir.ui.view">
        <field name="name">ai.skill.list</field>
        <field name="model">ai.skill</field>
        <field name="arch" type="xml">
            <list string="Skills" multi_edit="1">
                <field name="name"/>
                <field name="category"/>
                <field name="compatibility"/>
                <field name="source_type"/>
                <field name="version"/>
                <field name="use_count"/>
                <field name="agent_count"/>
                <field name="github_url" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Search -->
    <record id="view_ai_skill_search" model="ir.ui.view">
        <field name="name">ai.skill.search</field>
        <field name="model">ai.skill</field>
        <field name="arch" type="xml">
            <search string="Search Skills">
                <field name="name"/>
                <field name="description"/>
                <field name="trigger_keywords"/>
                <filter string="GitHub" name="github"
                        domain="[('source_type','=','github')]"/>
                <filter string="Odoo" name="odoo"
                        domain="[('source_type','=','odoo')]"/>
                <separator/>
                <filter string="Archived" name="inactive"
                        domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category"
                            context="{'group_by':'category'}"/>
                    <filter string="Source" name="group_source"
                            context="{'group_by':'source_type'}"/>
                    <filter string="Compatibility" name="group_compat"
                            context="{'group_by':'compatibility'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form -->
    <record id="view_ai_skill_form" model="ir.ui.view">
        <field name="name">ai.skill.form</field>
        <field name="model">ai.skill</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_skill_builder" type="object"
                            string="🤖 Build with AI" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_export_skill_md" type="object"
                                class="oe_stat_button" icon="fa-share-square-o"
                                string="Export SKILL.md"/>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Skill Name"/></h1>
                    </div>
                    <group col="2">
                        <field name="category"/>
                        <field name="compatibility"/>
                        <field name="source_type"/>
                        <field name="github_url"
                               widget="url"
                               invisible="source_type!='github'"
                               placeholder="https://github.com/user/repo"/>
                        <field name="version"/>
                        <field name="use_count" readonly="1"/>
                        <field name="agent_count" readonly="1"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <group string="Description">
                        <field name="description" widget="text" nolabel="1"/>
                    </group>
                    <group string="Triggers">
                        <field name="trigger_keywords"
                               placeholder="moms, deklaration, skatteverket"/>
                    </group>
                    <notebook>
                        <page string="Recipe">
                            <field name="recipe_text" widget="text" nolabel="1"/>
                        </page>
                        <page string="Verify Cases">
                            <group string="Success">
                                <field name="success_cases" widget="text" nolabel="1"/>
                            </group>
                            <group string="Failure">
                                <field name="failure_cases" widget="text" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Improve">
                            <group string="Guidance">
                                <field name="improvement_guidance" widget="text" nolabel="1"/>
                            </group>
                            <group string="References">
                                <field name="improvement_references" widget="text" nolabel="1"/>
                            </group>
                            <button name="action_improve" type="object"
                                    string="Apply Improvement" class="btn-primary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Export Wizard -->
    <record id="view_ai_skill_export_wizard" model="ir.ui.view">
        <field name="name">ai.skill.export.wizard</field>
        <field name="model">ai.skill.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export SKILL.md">
                <group>
                    <field name="skill_md" widget="text" nolabel="1"
                           colspan="2" height="400"/>
                </group>
                <footer>
                    <button name="action_copy" type="object"
                            string="Copy to Clipboard" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Inherited kanban with improved card layout (employee-style) -->
    <record id="view_ai_skill_kanban_inherit" model="ir.ui.view">
        <field name="name">ai.skill.kanban.inherit</field>
        <field name="model">ai.skill</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_skill_kanban"/>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <!-- Add default_group_by on kanban root -->
            <xpath expr="//kanban" position="attributes">
                <attribute name="default_group_by">category</attribute>
            </xpath>

            <!-- Declare additional fields used in the new card template -->
            <xpath expr="//kanban" position="inside">
                <field name="name"/>
                <field name="description"/>
                <field name="github_url"/>
                <field name="active"/>
            </xpath>

            <!-- Replace the entire card template -->
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <div class="oe_kanban_card oe_kanban_global_click d-flex flex-row"
                         t-att-class="{'border-danger border-2': !record.active.raw_value}">
                        <!-- Inactive ribbon (web_ribbon widget) -->
                        <widget name="web_ribbon" title="Inactive" bg_color="text-bg-danger" invisible="active"/>

                        <!-- Avatar / image aside -->
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.image_128.raw_value">
                                <field name="image_128" widget="background_image"
                                       options="{'preview_image': 'image_128'}"
                                       class="d-block position-relative"/>
                            </t>
                            <t t-else="">
                                <div class="d-flex align-items-center justify-content-center bg-100 bg-gradient"
                                     style="min-height: 100px;">
                                    <i class="fa fa-cog fa-3x text-secondary opacity-50"/>
                                </div>
                            </t>
                        </aside>

                        <!-- Main content -->
                        <main class="ms-2 d-flex flex-column" style="min-width: 0;">
                            <!-- Name -->
                            <div class="d-flex align-items-start">
                                <strong class="fs-5 o_text_overflow">
                                    <field name="name"/>
                                </strong>
                            </div>

                            <!-- Description (truncated to 2 lines) -->
                            <div class="text-muted small mt-1"
                                 style="max-height: 2.8em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                <field name="description"/>
                            </div>

                            <!-- Footer with badges and meta -->
                            <footer class="mt-auto pt-2">
                                <div class="d-flex justify-content-between align-items-end w-100">
                                    <!-- Left: badges -->
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        <!-- Category badge (colored) -->
                                        <span t-if="record.category.raw_value"
                                              class="badge" t-att-class="{
                                                  'bg-success': record.category.raw_value == 'development',
                                                  'bg-info': record.category.raw_value == 'infrastructure',
                                                  'bg-warning text-dark': record.category.raw_value == 'accounting',
                                                  'bg-primary': record.category.raw_value == 'communication',
                                                  'bg-danger': record.category.raw_value == 'research',
                                                  'bg-secondary': record.category.raw_value == 'general' || record.category.raw_value == 'analysis'
                                              }">
                                            <field name="category"/>
                                        </span>

                                        <!-- GitHub clickable badge -->
                                        <a t-if="record.github_url.raw_value"
                                           t-att-href="record.github_url.raw_value"
                                           target="_blank"
                                           class="badge bg-dark text-white text-decoration-none d-inline-flex align-items-center gap-1"
                                           title="Open GitHub repository">
                                            <i class="fa fa-github"/>
                                            GitHub
                                        </a>

                                        <!-- Source type badge (dold om github, då GitHub-badge visas istället) -->
                                        <span t-if="record.source_type.raw_value and record.source_type.raw_value != 'github'"
                                              class="badge" t-att-class="{
                                                  'bg-odoo': record.source_type.raw_value == 'odoo',
                                                  'bg-info': record.source_type.raw_value == 'pi'
                                              }">
                                            <field name="source_type"/>
                                        </span>

                                        <!-- Compatibility badge -->
                                        <span t-if="record.compatibility.raw_value"
                                              class="badge bg-light text-dark border">
                                            <field name="compatibility"/>
                                        </span>
                                    </div>

                                    <!-- Right: version + use count -->
                                    <div class="d-flex align-items-center text-muted small gap-2 flex-shrink-0">
                                        <span t-if="record.version.raw_value">
                                            v<field name="version"/>
                                        </span>
                                        <span t-if="record.use_count.raw_value"
                                              class="text-nowrap">
                                            <i class="fa fa-line-chart me-1"/>
                                            <field name="use_count"/> uses
                                        </span>
                                    </div>
                                </div>
                            </footer>
                        </main>
                    </div>
                </t>
            </xpath>
        </field>
    </record>
</odoo>
