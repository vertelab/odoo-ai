<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tool action (must come before menuitem reference) -->
    <record id="action_ai_tool" model="ir.actions.act_window">
        <field name="name">Custom Tools</field>
        <field name="res_model">ai.tool</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Tool list view -->
    <record id="view_ai_tool_tree" model="ir.ui.view">
        <field name="name">ai.tool.list</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <list string="AI Tools">
                <field name="name"/>
                <field name="builtin_name" string="Builtin" widget="badge"
                       optional="show" decoration-info="builtin_name != False"/>
                <field name="executor"/>
                <field name="risk_level" widget="badge"/>
                <field name="group_ids" widget="many2many_tags" string="Access Groups" optional="show"/>
                <field name="call_count" string="Calls"/>
                <field name="error_count" string="Errors"/>
                <field name="active" invisible="1"/>
                <button name="action_open_form" type="object" string="Visa"
                        icon="fa-eye"/>
            </list>
        </field>
    </record>

    <!-- Tool form view -->
    <record id="view_ai_tool_form" model="ir.ui.view">
        <field name="name">ai.tool.form</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <form string="AI Tool">
                <header>
                    <button name="action_test" type="object" string="Test Tool"
                            class="btn-primary"
                            invisible="executor == 'nats'"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Tool Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"
                                   placeholder="What this tool does (shown to LLM)..."/>
                            <field name="builtin_name" readonly="1"/>
                            <field name="risk_level"/>
                            <field name="executor"/>
                            <field name="capabilities"
                                   placeholder='["browser", "infra"]'/>
                            <field name="group_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="call_count"/>
                            <field name="error_count"/>
                            <field name="last_called"/>
                        </group>
                    </group>
                    <group string="NATS Config"
                           invisible="executor != 'nats'">
                        <field name="nats_subject"/>
                        <field name="nats_skills"
                               placeholder="agent-browser, caddy-routing"/>
                        <field name="nats_timeout"/>
                    </group>
                    <group string="Code"
                           invisible="executor == 'nats'">
                        <field name="code" widget="code"
                               options="{'mode': 'python'}"
                               placeholder="async def execute(**kwargs): return 'result'"/>
                    </group>
                    <group string="Parameters (JSON Schema)">
                        <field name="parameters" widget="code"
                               options="{'mode': 'javascript'}"
                               placeholder='{"type": "object", "properties": {...}}'/>
                    </group>
                    <group string="Usage">
                        <field name="agent_ids" widget="many2many_tags"/>
                        <field name="coworker_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tool search view -->
    <record id="view_ai_tool_search" model="ir.ui.view">
        <field name="name">ai.tool.search</field>
        <field name="model">ai.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="safe" string="Safe" domain="[('risk_level','=','safe')]"/>
                <filter name="read_only" string="Read Only"
                        domain="[('risk_level','=','read_only')]"/>
                <filter name="write" string="Write" domain="[('risk_level','=','write')]"/>
                <filter name="destructive" string="Destructive"
                        domain="[('risk_level','=','destructive')]"/>
            </search>
        </field>
    </record>


    <!-- Capability action + views (ai-tool-access-capabilities) -->
    <record id="action_ai_tool_capability" model="ir.actions.act_window">
        <field name="name">Capabilities</field>
        <field name="res_model">ai.tool.capability</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_ai_tool_capability_tree" model="ir.ui.view">
        <field name="name">ai.tool.capability.list</field>
        <field name="model">ai.tool.capability</field>
        <field name="arch" type="xml">
            <list string="Capabilities" editable="bottom">
                <field name="name"/>
                <field name="member_ids" widget="many2many_tags" string="Tools"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ai_tool_capability_form" model="ir.ui.view">
        <field name="name">ai.tool.capability.form</field>
        <field name="model">ai.tool.capability</field>
        <field name="arch" type="xml">
            <form string="Capability">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Capability Name"/></h1>
                    </div>
                    <group>
                        <field name="description"
                               placeholder="syfte / när / när inte / exempel / output / guardrail"/>
                        <field name="member_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
