<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_ai" model="ir.ui.view">
        <field name="name">res.company.form.inherit.ai_agent_core</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="mission" string="Our Mission">
                    <field name="company_mission" nolabel="1"
                           placeholder="Describe your company's mission statement..."/>
                </page>
                <page name="values" string="Our Values">
                    <field name="company_values" nolabel="1"
                           placeholder="Describe your company's core values..."/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
