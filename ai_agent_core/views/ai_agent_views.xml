<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_agent_kanban" model="ir.ui.view">
        <field name="name">ai.agent.kanban</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="ai_role"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="o_kanban_card_header">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="o_kanban_card_content">
                                <field name="ai_role" class="text-muted small"/>
                            </div>
                            <div class="o_kanban_card_footer">
                                <field name="status" widget="badge"
                                       decoration-success="status=='active'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ai_agent_list" model="ir.ui.view">
        <field name="name">ai.agent.list</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <list string="AI Agents">
                <field name="name"/>
                <field name="ai_role"/>
                <field name="model_id"/>
                <field name="status"/>
                <field name="quest_count"/>
            </list>
        </field>
    </record>

    <record id="ai_agent_form" model="ir.ui.view">
        <field name="name">ai.agent.form</field>
        <field name="model">ai.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Agent Name"/></h1>
                        <field name="ai_role" placeholder="e.g. Financial Analyst"/>
                    </div>
                    <group col="2">
                        <field name="identity_id"/>
                        <field name="status"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="ai_goal" widget="text"
                                       placeholder="What this agent aims to accomplish..."/>
                                <field name="ai_backstory" widget="text"
                                       placeholder="Background context..."/>
                                <field name="description" widget="text"
                                       placeholder="What this agent does — used by supervisor router..."/>
                            </group>
                        </page>
                        <page string="Model">
                            <group>
                                <field name="model_id"
                                       domain="[('status','=','active')]"/>
                                <field name="model_name" readonly="1"/>
                            </group>
                            <group string="Config">
                                <field name="temperature"/>
                                <field name="max_tokens"/>
                                <field name="max_rounds"/>
                            </group>
                        </page>
                        <page string="Skills">
                            <field name="skill_ids" widget="many2many_tags"/>
                        </page>
                        <page string="Tools">
                            <field name="tool_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="risk_level"/>
                                </list>
                            </field>
                        </page>
                        <page string="Memories">
                            <field name="memory_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="memory_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Budget">
                            <group>
                                <field name="budget_limit"/>
                                <field name="budget_used" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
