<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly Summary Tree -->
    <record id="ai_monthly_summary_tree" model="ir.ui.view">
        <field name="name">ai.coworker.monthly_summary.tree</field>
        <field name="model">ai.coworker.monthly_summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="month"/>
                <field name="coworker_id"/>
                <field name="total_sys_tokens"/>
                <field name="started_mtokens"/>
                <field name="total_input_tokens" optional="hide"/>
                <field name="total_output_tokens" optional="hide"/>
                <field name="session_count"/>
                <field name="monthly_cap_mtokens" optional="hide"/>
                <field name="budget_exhausted" optional="hide"/>
                <field name="budget_warning" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Monthly Summary Pivot -->
    <record id="ai_monthly_summary_pivot" model="ir.ui.view">
        <field name="name">ai.coworker.monthly_summary.pivot</field>
        <field name="model">ai.coworker.monthly_summary</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="coworker_id" type="row"/>
                <field name="month" type="col"/>
                <field name="total_sys_tokens" type="measure"/>
                <field name="started_mtokens" type="measure"/>
                <field name="session_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Monthly Summary Graph -->
    <record id="ai_monthly_summary_graph" model="ir.ui.view">
        <field name="name">ai.coworker.monthly_summary.graph</field>
        <field name="model">ai.coworker.monthly_summary</field>
        <field name="arch" type="xml">
            <graph type="bar" stacked="True">
                <field name="coworker_id" type="row"/>
                <field name="month" type="col"/>
                <field name="total_sys_tokens" type="measure"/>
                <field name="started_mtokens" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Dashboard action -->
    <record id="ai_monthly_summary_action" model="ir.actions.act_window">
        <field name="name">Månadsrapporter</field>
        <field name="res_model">ai.coworker.monthly_summary</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help">Systemtoken-förbrukning per quest och månad. Historisk rapportering för fakturering.</field>
    </record>

    <!-- Search for monthly summaries -->
    <record id="ai_monthly_summary_search" model="ir.ui.view">
        <field name="name">ai.coworker.monthly_summary.search</field>
        <field name="model">ai.coworker.monthly_summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="coworker_id"/>
                <field name="month"/>
                <filter string="Denna månad" name="this_month"
                        domain="[('month', '=', context_today().strftime('%Y-%m'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Medarbetare" name="group_quest" context="{'group_by':'coworker_id'}"/>
                    <filter string="Månad" name="group_month" context="{'group_by':'month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
