<odoo>
    <data noupdate="1">

        <record id="record_ai_agent_developer_quest_rule" model="ir.rule">
            <field name="name">User can only see their own quest records</field>
            <field name="model_id" ref="model_ai_quest"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_agent_developer'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>

    </data>
</odoo>