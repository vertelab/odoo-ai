<odoo>
    <data noupdate="1">

        <!-- Odoo 20: ir.rule ersatt av ir.access (model_id/group_id/operation/domain).
             perm_*-flaggorna blir en operation-selection; 'global' = group_id tom. -->

        <!-- #if VERSION >= "20.0" -->
        <record id="record_ai_agent_developer_quest_rule" model="ir.access">
            <field name="name">User can only see their own quest records</field>
            <field name="model_id" ref="model_ai_quest"/>
            <field name="group_id" ref="group_ai_agent_developer"/>
            <field name="operation">crud</field>
            <field name="domain">[('user_id', '=', user.id)]</field>
        </record>
        <!-- #else -->
        <record id="record_ai_agent_developer_quest_rule" model="ir.rule">
            <field name="name">User can only see their own quest records</field>
            <field name="model_id" ref="model_ai_quest"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_agent_developer'))]"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="perm_read" eval="1"/>
        </record>
        <!-- #endif -->

        <!-- #if VERSION >= "20.0" -->
        <record model="ir.access" id="memory_shared_company_rule">
            <field name="name">Shared Memory: multi-company</field>
            <field name="model_id" ref="model_ai_memory"/>
            <field name="operation">crud</field>
            <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <!-- #else -->
        <record model="ir.rule" id="memory_shared_company_rule">
            <field name="name">Shared Memory: multi-company</field>
            <field name="model_id" ref="model_ai_memory"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <!-- #endif -->

