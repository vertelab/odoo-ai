<odoo>
    <data>

        <record id="ai_agent_form" model="ir.ui.view">
            <field name="name">ai.agent.form</field>
            <field name="model">ai.agent</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" modifiers="{&quot;required&quot;: true}"/>
                            </group>
                        </group>
                        <group>
                            <field name="ai_prompt_template"/>
                        </group>
                        <group>
                            <group>
                                <field name="ai_agent_model_id" can_create="true" can_write="true"/>
                            </group>
                        </group>
                        <group>
                            <separator/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ai_agent_tree" model="ir.ui.view">
            <field name="name">ai.agent.tree</field>
            <field name="model">ai.agent</field>
            <field name="arch" type="xml">
                <tree >
                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                </tree>
            </field>
        </record>

