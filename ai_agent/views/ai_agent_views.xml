    <menuitem id="ai_agent.menu_ai_agent_menu" parent="ai_agent.menu_ai_agent_root" name="Agents and Quests" />
    <menuitem id="ai_agent.menu_ai_agent_menu_menu" parent="ai_agent.menu_ai_agent_menu" name="Agents" />
