<odoo>
    <data>
        <record id="ai_quest_session_form" model="ir.ui.view">
            <field name="name">ai.quest.sesion.form</field>
            <field name="model">ai.quest.session</field>
            <field name="arch" type="xml">
                <form>
                    <sheet string="AI Quest Session">
                        <group>
                            <group>
                                <field name="status"/>
                                <field name="ai_type"/>
                            </group>
                            <group>
                                <field name="ai_quest_id" can_create="true" can_write="true"/>
                                <field name="session"/>
                            </group>
                        </group>
                        <group>
                            <field name="ai_agent_ids">
                                <list>
                                    <field name="name" modifiers="{&quot;required&quot;: true}"/>
                                </list>
                            </field>
                        </group>
                        <group>
                            <group>
                                <field name="startdate"/>
                            </group>
                            <group>
                                <field name="enddate"/>
                            </group>
                        </group>
                        <group>
                            <field name="type_of_output"/>
                        </group>
                        <group/>
                        <group>
                            <separator/>
                        </group>
                        <notebook>
                            <page name="lines" string="Lines">
                                <field name="ai_quest_session_line_ids">
                                    <list>
                                        <field name="finish_reason"/>
                                        <field name="input_tokens"/>
                                        <field name="output_tokens"/>
                                        <field name="total_tokens" />
                                        <field name="model_name"/>
                                        <field name="ai_id" optional="hide"/>
                                        <field name="system_fingerprint" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="action_ai_quest_session" model="ir.actions.act_window">
            <field name="name">AI Quest Session</field>
            <field name="res_model">ai.quest.session</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="ai_agent.menu_ai_quest_session" name="Ai Quest Session" parent="ai_agent.menu_ai_agent_configuration" action="action_ai_quest_session"/>

    </data>
</odoo>