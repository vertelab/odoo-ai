<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Source: https://python.langchain.com/v0.1/docs/integrations/llms/anthropic/ -->
    <!-- Source: https://docs.anthropic.com/en/docs/about-claude/models -->
    <record id="anthropic_ai_product_template" model="product.template">
      <field name="name">Anthropic-AI</field>
      <field name="is_llm">True</field>
      <field name="llm_type">ChatGroq_XXXXXXXXXXXX_NOT_CORRECT!</field>
    </record>
    <!-- Model -->
    <record id="anthropic_product_attribute_value_claude-3-5-sonnet-latest" model="product.attribute.value">
      <field name="name">claude-3-5-sonnet-latest</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="anthropic_product_attribute_value_claude-3-5-haiku-latest" model="product.attribute.value">
      <field name="name">claude-3-5-haiku-latest</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="anthropic_product_attribute_value_claude-3-opus-latest" model="product.attribute.value">
      <field name="name">claude-3-opus-latest</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="anthropic_product_attribute_value_claude-3-sonnet-latest" model="product.attribute.value">
      <field name="name">claude-3-sonnet-latest</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="anthropic_product_attribute_value_claude-3-haiku-latest" model="product.attribute.value">
      <field name="name">claude-3-haiku-latest</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <!-- Attribute Line -->
    <record id="anthropic_ai_product_template_attribute_line_model" model="product.template.attribute.line">
      <field name="product_tmpl_id" ref="anthropic_ai_product_template" />
      <field name="attribute_id" ref="product_attribute_model" />
      <field name="value_ids" eval="[(6, 0, [
                            ref('claude-3-5-sonnet-latest'),
                            ref('claude-3-5-haiku-latest'),
                            ref('claude-3-opus-latest'),
                            ref('claude-3-sonnet-latest'),
                            ref('claude-3-haiku-latest'),
                    ])]" />
    </record>
  </data>
</odoo>
