<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="groq_ai_product_template" model="product.template">
      <field name="name">Groq-AI</field>
      <field name="is_llm">True</field>
      <field name="llm_type">ChatGroq</field>
    </record>
    <!-- Model -->
    <record id="groq_product_attribute_value_distil-whisper-large-v3-en" model="product.attribute.value">
      <field name="name">distil-whisper-large-v3-en</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_gemma2-9b-it" model="product.attribute.value">
      <field name="name">gemma2-9b-it</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_llama-3.3-70b-versatile" model="product.attribute.value">
      <field name="name">llama-3.3-70b-versatile</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_llama-3.1-8b-instant" model="product.attribute.value">
      <field name="name">llama-3.1-8b-instant</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_llama-guard-3-8b" model="product.attribute.value">
      <field name="name">llama-guard-3-8b</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_llama3-70b-8192" model="product.attribute.value">
      <field name="name">llama3-70b-8192</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_llama3-8b-8192" model="product.attribute.value">
      <field name="name">llama3-8b-8192</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_mixtral-8x7b-32768" model="product.attribute.value">
      <field name="name">mixtral-8x7b-32768</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <record id="groq_product_attribute_value_whisper-large-v3" model="product.attribute.value">
      <field name="name">whisper-large-v3</field>
