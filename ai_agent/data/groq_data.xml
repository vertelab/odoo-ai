      <field name="name">whisper-large-v3-turbo</field>
      <field name="attribute_id" ref="ai_agent.product_attribute_model" />
    </record>
    <!-- Attribute Line -->
    <record id="groq_ai_product_template_attribute_line_model" model="product.template.attribute.line">
      <field name="product_tmpl_id" ref="groq_ai_product_template" />
      <field name="attribute_id" ref="product_attribute_model" />
      <field name="value_ids" eval="[(6, 0, [
                            ref('distil-whisper-large-v3-en'),
                            ref('gemma2-9b-it'),
                            ref('llama-3.3-70b-versatile'),
                            ref('llama-3.1-8b-instant'),
                            ref('llama-guard-3-8b'),
                            ref('llama3-70b-8192'),
                            ref('llama3-8b-8192'),
                            ref('mixtral-8x7b-32768'),
                            ref('whisper-large-v3'),
                            ref('whisper-large-v3-turbo'),
                    ])]" />
    </record>
  </data>
