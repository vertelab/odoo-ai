<odoo>
    <data>
        <record id="mail_alias_form_view" model="ir.ui.view">
            <field name="name">mail.alias.form</field>
            <field name="model">mail.alias</field>
            <field name="inherit_id" ref="mail.view_mail_alias_form" />
            <field name="arch" type="xml">
                <xpath expr="//group[last()]" position="after">
                    <group>
                        <field name="ai_quest" />
                        <field name="ai_agent" />
                    </group>
                </xpath>
            </field>
        </record>

        <record id="mail_alias_tree_view" model="ir.ui.view">
            <field name="name">mail.alias.tree</field>
            <field name="model">mail.alias</field>
            <field name="inherit_id" ref="mail.view_mail_alias_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[last()]" position="after">
                    <group>
                        <field name="ai_quest" />
                        <field name="ai_agent" />
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>