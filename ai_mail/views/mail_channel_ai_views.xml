<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="mail_channel_ai_view_search" model="ir.ui.view">
        <field name="name">mail.channel.ai.view.search</field>
        <field name="model">mail.channel.ai</field>
        <field name="arch" type="xml">
            <search string="AI Mail Channel">
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                <field name="name"/>
                <field name="ai_model_id"/>
            </search>
        </field>
    </record>

    <record id="mail_channel_ai_view_tree" model="ir.ui.view">
        <field name="name">mail.channel.ai.view.tree</field>
        <field name="model">mail.channel.ai</field>
        <field name="arch" type="xml">
            <tree string="AI Mail Channel">
                <field name="name"/>
                <field name="ai_model_id"/>
            </tree>
        </field>
    </record>

    <record id="mail_channel_ai_view_form" model="ir.ui.view">
        <field name="name">mail.channel.ai.form</field>
        <field name="model">mail.channel.ai</field>
        <field name="arch" type="xml">
            <form string="AI Mail Channel">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name" string="Mail Channel"/>
                        <h1>
                            <field class="text-break" name="name" placeholder="e.g. North America"/>
                        </h1>
                    </div>
                    <group>
                        <group name="left" string="Team Details">
                            <field name="active" invisible="1"/>
                            <field name="sequence" invisible="1"/>
                             <label for="alias_name" string="Email Alias"/>
                            <div class="oe_inline" name="alias_def">
                                <field name="alias_id" class="oe_read_only oe_inline"
                                    string="Email Alias" required="0"
                                    attrs="{'invisible': [('alias_domain', '=', False)]}"/>
                                <div class="oe_inline" name="edit_alias" style="display: inline;" >
                                    <div class="oe_edit_only" attrs="{'invisible': [('alias_domain', '=', False)]}" dir="ltr">
                                        <field name="alias_name" class="oe_inline"/>@<field name="alias_domain" class="oe_inline" readonly="1"/>
                                    </div>
                                    <button icon="fa-arrow-right" type="action" name="%(base_setup.action_general_configuration)d" string="Configure a custom domain" class="p-0 btn-link" attrs="{'invisible': [('alias_domain', '!=', False)]}"/>
                                </div>
                            </div>
                            <field name="alias_contact" string="Accept Emails From"/>
<!--                            <field name="alias_model_id"/>-->
<!--                            <field name="alias_name"/>-->
                        </group>
                        <group name="right">
                        </group>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" help="Follow this salesteam to automatically track the events associated to users of this team."/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="mail_channel_ai_action_config" model="ir.actions.act_window">
        <field name="name">AI Mail Channel</field>
        <field name="res_model">mail.channel.ai</field>
        <field name="view_mode">tree,form</field>
    </record>

</data>
</odoo>
