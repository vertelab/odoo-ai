<?xml version="1.0"?>
<odoo>
    <record id="mail_ai_view_form" model="ir.ui.view">
        <field name="name">mail.ai.form</field>
        <field name="model">mail.ai</field>
        <field name="arch" type="xml">
            <form create="false" duplicate="false">
                <header>
                    <button name="get_mail_activity" string="Mail Activity" class="btn btn-primary" type="object"/>
                    <button name="create_lead" string="Create Lead" class="btn btn-primary" type="object" attrs="{'invisible': [('crm_lead_id', '!=', False)]}"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_crm_lead" type="object" class="oe_stat_button" icon="fa-funnel" attrs="{'invisible': [('crm_lead_id', '=', False)]}">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Leads</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field class="text-break" name="name" placeholder="e.g. Subject"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="email_from"/>
                            <field name="mail_channel_id"/>
                            <field name="crm_lead_id" invisible="1"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Content" name="content">
                            <field name="description" placeholder="Add a description..." options="{'collaborative': true}" />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                </div>
            </form>
        </field>
    </record>


    <record id="ai_model_tree_view_leads" model="ir.ui.view">
        <field name="name">mail.ai.tree.lead</field>
        <field name="model">mail.ai</field>
        <field name="arch" type="xml">
            <tree create="false" duplicate="false">
                <field name="company_id" invisible="1"/>
                <field name="create_date" optional="hide"/>
                <field name="name"/>
                <field name="mail_channel_id"/>
            </tree>
        </field>
    </record>


    <record id="view_ai_mail_filter" model="ir.ui.view">
        <field name="name">mail.ai.search.lead</field>
        <field name="model">mail.ai</field>
        <field name="arch" type="xml">
            <search string="Search Leads">
                <field name="name" string="Lead"/>
            </search>
        </field>
    </record>


    <!-- Lead Menu -->
    <record model="ir.actions.act_window" id="ai_mail_action">
        <field name="name">Mail AI</field>
        <field name="res_model">mail.ai</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="ai_mail.view_ai_mail_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Lead
            </p><p>
                Leads are the qualification step before the creation of an opportunity.
            </p>
        </field>
    </record>

</odoo>
