<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transcript-sessionens fält (ai_agent_transcript → ai_agent_core).
         interface_key/text_selection/frontend_info finns bara när transcript
         är installerat; ärver core-vyerna (Odoo 18: list, aldrig tree).

         transcript_context visas medvetet INTE här: fältet var en andra,
         oberoende beräkning av samma kontext som kärnan bygger, och en
         felsökningsvy som visar fel sak är sämre än ingen (5.1). -->

    <record id="view_ai_session_list_transcript" model="ir.ui.view">
        <field name="name">ai.coworker.session.list.transcript</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='coworker_id']" position="after">
                <field name="interface_key" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_ai_session_form_transcript" model="ir.ui.view">
        <field name="name">ai.coworker.session.form.transcript</field>
        <field name="model">ai.coworker.session</field>
        <field name="inherit_id" ref="ai_agent_core.view_ai_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="transcript" string="Powerbox">
                    <field name="interface_key" readonly="1"/>
                    <field name="text_selection" readonly="1"/>
                    <field name="frontend_info" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
