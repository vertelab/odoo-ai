<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend AI Quest Session Form with Powerbox/Transcript fields -->
    <record id="view_ai_quest_session_form_inherit_transcript" model="ir.ui.view">
        <field name="name">ai.quest.session.form.inherit.transcript</field>
        <field name="model">ai.quest.session</field>
        <field name="inherit_id" ref="ai_agent.view_ai_quest_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Powerbox / Transcript" col="4"
                       attrs="{'invisible': [('interface_key', '=', False)]}">
                    <field name="interface_key" widget="badge"/>
                    <field name="composer_id"/>
                    <field name="context_record_model"/>
                    <field name="context_record_id"/>
                </group>
                <group string="Transcript Context"
                       attrs="{'invisible': [('transcript_context', '=', False)]}">
                    <field name="transcript_context"
                           widget="ace"
                           readonly="1"
                           nolabel="1"
                           style="min-height: 200px;"/>
                </group>
                <group string="Powerbox Prompts"
                       attrs="{'invisible': [('powerbox_prompts', '=', False)]}">
                    <field name="powerbox_prompts"
                           readonly="1"
                           nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
