<odoo>
    <data>
        <record id="ai_quest_list" model="ir.ui.view">
            <field name="name">ai.quest.list.department</field>
            <field name="model">ai.quest</field>
            <field name="inherit_id" ref="ai_agent.ai_quest_list" />
            <field name="arch" type="xml">
                <field name="status" position="after">
                    <field name="department_id" />
                </field>
            </field>
        </record>
        <record id="ai_quest_search" model="ir.ui.view">
            <field name="name">ai.quest.search.department</field>
            <field name="model">ai.quest</field>
            <field name="inherit_id" ref="ai_agent.ai_quest_search" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="department_id" />
                </field>
                <filter name="group_by_partner" position="after">
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}" />
                </filter>
            </field>
        </record>
        <record id="ai_quest_form" model="ir.ui.view">
            <field name="name">ai.quest.form.department</field>
            <field name="model">ai.quest</field>
            <field name="inherit_id" ref="ai_agent.ai_quest_form" />
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="department_id" />
                </field>
            </field>
        </record>
        <record id="view_ai_quest_kanban" model="ir.ui.view">
            <field name="name">ai.quest.kanban.department</field>
            <field name="model">ai.quest</field>
            <field name="inherit_id" ref="ai_agent.view_ai_quest_kanban" />
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="department_id" />
                </field>
                <xpath expr="//div[hasclass('o_kanban_record_bottom')]//div[hasclass('oe_kanban_bottom_right')]" position="inside">
                    <field name="department_id" widget="many2one_avatar" />
                </xpath>
            </field>
        </record>
        <record id="view_ai_quest_calendar" model="ir.ui.view">
            <field name="name">ai.quest.calendar.department</field>
            <field name="model">ai.quest</field>
            <field name="inherit_id" ref="ai_agent.view_ai_quest_calendar" />
            <field name="arch" type="xml">
                <field name="status" position="after">
                    <field name="department_id" />
                </field>
            </field>
        </record>
    </data>
</odoo>
