<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_quest_form" model="ir.ui.view">
        <field name="name">ai.quest.feedback.form</field>
        <field name="model">ai.quest</field>
        <field name="inherit_id" ref="ai_agent.ai_quest_form"/>
        <field name="arch" type="xml">
            <label for="use_chat_history" position="after">
                <field name="use_feedback_history"/>
                <field name="feedback_llm" invisible="use_feedback_history == False" required="use_feedback_history"/>
            </label>
        </field>
    </record>

</odoo>
